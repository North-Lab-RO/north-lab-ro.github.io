---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Scene from '../components/3d/Scene.astro';
import NewsTicker from '../components/project/NewsTicker.astro';
import Gallery from '../components/project/Gallery.astro';
import ProjectVisual from '../components/project/ProjectVisual.astro';
import SalesBlock from '../components/sales/SalesBlock.astro';
import Workflows from '../components/diagrams/Workflows.astro';
import { getWorkflows } from '../components/diagrams/workflows';
import DemoButton from '../components/sales/DemoButton.astro';
import CtaBand from '../components/sales/CtaBand.astro';
import { accentVar, type Project } from '../lib';
import { t, projectHref, homeHref, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  entry: Project;
  next: Project;
}
const { lang, entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const wf = getWorkflows(entry.slug, lang);
const tp = t(lang).project;
const ts = t(lang).sales;
const forLabel = t(lang).projects.forLabel;
const sceneLabels = {
  en: {
    globe: 'A globe of news stories coloured by category. Coverage arrives from many outlets, the leading story rises, is analysed stage by stage, crosses the importance threshold and raises an alert, and the top stories feed the morning briefing',
    board: 'An evidence board of pinned photographs joined by red string',
    radar: 'A live airfield on a radar scope: aircraft tagged with callsign and type fly the arrival routes, land on runway 08 and take off on the departure route, while the tower works through each clearance: heard, understood, checked, answered',
    ledger: 'BANKY reviewing an imported statement: each line is read by the bank’s rules and lands in a review list with a suggested category and how sure it is; a possible duplicate and one uncertain row wait for you, the clean rows are confirmed in one click and fill the spending-by-category chart',
    graph: 'An OSINT investigation board in front of Athena’s shield: a subject with its identifiers, collectors searching them, findings confirmed or rejected by an analyst, a location pin, a relationship, and a report filling with the confirmed findings',
  },
  ro: {
    globe: 'Un glob cu povești de știri colorate după categorie. Relatările vin din multe publicații, povestea principală crește, e analizată etapă cu etapă, trece pragul de importanță și declanșează o alertă, iar cele mai importante povești intră în sinteza de dimineață',
    board: 'Un panou de probe cu fotografii prinse în ace și legate cu sfoară roșie',
    radar: 'Un aeroport live pe un ecran radar: avioane etichetate cu indicativ și tip urmează rutele de sosire, aterizează pe pista 08 și decolează pe ruta de plecare, iar turnul trece prin fiecare autorizare: auzită, înțeleasă, verificată, transmisă',
    ledger: 'BANKY verifică un extras importat: fiecare rând e citit cu regulile băncii și ajunge într-o listă de verificare cu o categorie sugerată și cât de sigur e sistemul; o posibilă dublură și un rând nesigur te așteaptă pe tine, rândurile curate se confirmă dintr-un clic și umplu graficul cheltuielilor pe categorii',
    graph: 'Un panou de investigație OSINT în fața scutului Atenei: un subiect cu identificatorii săi, colectoare care îi caută, constatări confirmate sau respinse de un analist, un pin pe hartă, o relație și un raport care se umple cu constatările confirmate',
  },
} as const;
---

<Base lang={lang} title={d.title} description={d.tagline}>
  <article class="project" style={`--accent:${accentVar[d.accent]}`}>
    <header class="hero wrap">
      <div class="intro">
        <a href={homeHref(lang, '#projects')} class="back label">{tp.back}</a>
        <p class="label cat" data-rise><span class="swatch" aria-hidden="true"></span>{d.category}</p>
        <h1 class="name" data-rise style="--delay:.04s">{d.title}</h1>
        <p class="display promise" data-rise style="--delay:.08s">{d.promise ?? d.tagline}</p>
        {d.promise && <p class="tagline" data-rise style="--delay:.12s">{d.tagline}</p>}
        {
          d.audienceShort.length > 0 && (
            <p class="for" data-rise style="--delay:.16s">
              <span class="label">{forLabel}</span>
              {d.audienceShort.map((a) => (
                <span class="chip">{a}</span>
              ))}
            </p>
          )
        }
        <div class="cta" data-rise style="--delay:.2s">
          <DemoButton lang={lang} product={d.title} />
          <a href="#tour" class="btn btn-ghost">{ts.tour} <span aria-hidden="true">↓</span></a>
        </div>
        <p class="badge" data-rise style="--delay:.24s">
          {
            d.repo.visibility === 'public' && d.repo.url ? (
              <a href={d.repo.url} class="chip" rel="noopener">{tp.source}</a>
            ) : (
              <span class="chip">
                <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="1.8"></path></svg>
                {tp.private}
              </span>
            )
          }
        </p>
      </div>
      <div class="stage">
        {
          d.scene !== 'none' ? (
            <Scene name={d.scene} class="scene" label={sceneLabels[lang][d.scene]} />
          ) : (
            <ProjectVisual scene="none" cover={d.cover} coverAlt={d.coverAlt} />
          )
        }
        {entry.slug === 'counselor' && <NewsTicker lang={lang} />}
      </div>
    </header>

    <SalesBlock lang={lang} entry={entry} />

    <CtaBand lang={lang} product={d.title} />

    <section class="wrap techdiv" aria-labelledby="tech-title">
      <p class="label">{ts.tech}</p>
      <h2 id="tech-title" class="h-section sm">{ts.techLede}</h2>
    </section>

    <section class="wrap overview">
      <p class="lede" data-reveal>{d.summary}</p>
      {
        d.metrics.length > 0 && (
          <dl class="metrics" data-reveal>
            {d.metrics.map((m) => (
              <div class="metric">
                <dt class="value">{m.value}</dt>
                <dd class="muted">{m.label}</dd>
              </div>
            ))}
          </dl>
        )
      }
    </section>

    {
      wf && (
        <section id="how" class="wrap block how" aria-labelledby="how-title">
          <h2 id="how-title" class="h-section sm" data-reveal>{t(lang).workflows.heading}</h2>
          <Workflows lang={lang} set={wf} uid={entry.slug} />
        </section>
      )
    }


    <section class="wrap block prose">
      <Content />
      {d.gallery.length > 0 && <Gallery lang={lang} items={d.gallery} />}
    </section>

    <section class="wrap block built">
      <p class="label">{tp.builtWith}</p>
      <ul class="stack">
        {d.stack.map((s) => <li class="chip">{s}</li>)}
      </ul>
      {d.credits && <p class="muted credits">{d.credits}</p>}
    </section>

    {
      next.id !== entry.id && (
        <nav class="wrap next" aria-label={tp.next}>
          <a href={projectHref(lang, next.slug)} style={`--accent:${accentVar[next.data.accent]}`}>
            <span class="label">{tp.next}</span>
            <span class="display name">{next.data.title}</span>
            <span class="muted">{next.data.tagline}</span>
          </a>
        </nav>
      )
    }
  </article>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 8px;
    padding-top: 88px;
    align-items: center;
  }
  .stage {
    position: relative;
    order: -1;
    margin-inline: calc(var(--gutter) * -1);
  }
  .stage :global(.scene) {
    height: min(62svh, 520px);
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    transition: color 0.2s;
  }
  .back:hover {
    color: var(--color-frost);
  }
  .cat {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .swatch {
    width: 18px;
    height: 2px;
    background: var(--accent);
  }
  .name {
    margin-top: 14px;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.2rem, 2.2vw, 1.6rem);
    letter-spacing: 0.04em;
    color: var(--accent);
  }
  .promise {
    margin-top: 10px;
    font-size: clamp(2rem, 5.4vw, 4.2rem);
    line-height: 1.04;
    max-width: 16ch;
  }
  .for {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    margin-top: 22px;
  }
  .for .label {
    margin-right: 4px;
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }
  .techdiv {
    padding-top: clamp(40px, 6vw, 72px);
  }
  .techdiv .label {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .techdiv .label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--color-line);
  }
  .techdiv h2 {
    margin-top: 18px;
    max-width: 28ch;
    color: color-mix(in srgb, var(--color-frost) 80%, var(--color-mist));
  }
  .tagline {
    margin-top: 22px;
    font-size: clamp(1.1rem, 1.7vw, 1.35rem);
    line-height: 1.5;
    max-width: 40ch;
  }
  .badge {
    margin-top: 26px;
  }
  .badge .chip {
    color: var(--color-mist);
    white-space: normal;
  }
  .overview {
    padding-top: clamp(48px, 7vw, 96px);
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    margin-top: 56px;
    border-top: 1px solid var(--color-line);
  }
  .metric {
    padding: 24px 16px 24px 0;
    border-bottom: 1px solid var(--color-line);
  }
  .value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 4.4vw, 3.2rem);
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--accent);
  }
  .metric dd {
    margin-top: 10px;
    font-size: 0.9rem;
    line-height: 1.4;
    max-width: 26ch;
  }
  .block {
    padding-top: clamp(72px, 10vw, 128px);
  }
  .h-section.sm {
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    margin-bottom: 36px;
  }
  .features {
    display: grid;
    gap: 0 40px;
    border-top: 1px solid var(--color-line);
  }
  .feature {
    padding-block: 24px;
    border-bottom: 1px solid var(--color-line);
  }
  .feature p {
    margin-top: 8px;
  }

  /* MDX body */
  .prose :global(h2) {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-top: clamp(64px, 8vw, 104px);
    margin-bottom: 20px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(h3:not([class])) {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: clamp(40px, 5vw, 64px);
    margin-bottom: 12px;
  }
  .prose :global(p) {
    max-width: 68ch;
    color: color-mix(in srgb, var(--color-frost) 85%, var(--color-mist));
  }
  .prose :global(em) {
    color: var(--color-frost);
  }

  .built .label {
    margin-bottom: 14px;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .credits {
    margin-top: 18px;
    font-size: 0.88rem;
  }
  .next {
    padding-block: clamp(72px, 10vw, 128px);
  }
  .next a {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    padding-top: 36px;
    border-top: 1px solid var(--color-line);
  }
  .next .name {
    font-size: clamp(1.9rem, 7vw, 5rem);
    overflow-wrap: anywhere;
    transition: color 0.4s var(--ease-out);
  }
  .next a:hover .name {
    color: var(--accent);
  }
  @media (min-width: 720px) {
    .metrics {
      grid-template-columns: repeat(4, 1fr);
    }
    .features {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 1024px) {
    .hero {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 40px;
      min-height: 88svh;
    }
    .stage {
      order: 0;
      margin-inline: 0;
    }
    .stage :global(.scene) {
      height: min(72svh, 640px);
    }
    .features {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
