---
import Base from '../layouts/Base.astro';
import { t } from '../i18n/ui';
const en = t('en').notFound;
const ro = t('ro').notFound;
---

<Base lang="en" title="404">
  <section class="wrap nf">
    <p class="label">{en.label}</p>
    <h1 class="display">{en.title}</h1>
    <p class="lede">{en.lede}</p>
    <a href="/" class="btn btn-primary">{en.back}</a>
    <div class="ro" lang="ro">
      <p class="label">{ro.label}</p>
      <p class="h-sub">{ro.title}</p>
      <p class="muted">{ro.lede}</p>
      <a href="/ro/" class="btn btn-ghost">{ro.back}</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 80svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 24px;
    padding-top: 96px;
    padding-bottom: 64px;
  }
  h1 {
    font-size: clamp(2.4rem, 7vw, 5rem);
    max-width: 14ch;
  }
  .btn {
    align-self: flex-start;
  }
  .ro {
    display: grid;
    gap: 12px;
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--color-line);
  }
</style>
