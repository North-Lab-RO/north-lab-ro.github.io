---
import ProjectView from '../../../views/ProjectView.astro';
import { getProjects } from '../../../lib';

export async function getStaticPaths() {
  const projects = await getProjects('ro');
  return projects.map((entry, i) => ({
    params: { slug: entry.slug },
    props: { entry, next: projects[(i + 1) % projects.length] },
  }));
}

const { entry, next } = Astro.props;
---

<ProjectView lang="ro" entry={entry} next={next} />
