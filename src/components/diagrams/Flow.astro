---
/**
 * A single workflow diagram: steps down a spine, decisions with side-exits.
 * A decision's `branches` leave the flow (tinted by tone); `yes` labels the path that carries on down the spine.
 * A last decision with branches and no `yes` is a set of outcomes. Rendering is shared with Workflows via FlowSteps.
 */
import FlowSteps from './FlowSteps.astro';
import type { WStep } from './workflows/types';

export type FlowNode = WStep;
interface Props {
  title: string;
  caption?: string;
  nodes: FlowNode[];
}
const { title, caption, nodes } = Astro.props;
---

<figure class="flow" data-reveal>
  <figcaption class="head">
    <span class="label">{title}</span>
    {caption && <span class="muted cap">{caption}</span>}
  </figcaption>
  <FlowSteps steps={nodes} level="h3" />
</figure>

<style>
  .flow {
    margin-block: 40px;
    padding: clamp(20px, 3vw, 36px);
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background:
      radial-gradient(80% 60% at 100% 0%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 60%),
      var(--color-deep);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 16px;
    align-items: baseline;
    margin-bottom: 28px;
  }
  .cap {
    font-size: 0.9rem;
  }
</style>
