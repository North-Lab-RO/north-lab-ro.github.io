---
import TourFrame from './TourFrame.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Radio transmissions stay in ICAO English on both pages.
const log = [
  ['ROT301', 'Otopeni Ground, TAROM three zero one, stand 12, request taxi.'],
  ['GND', 'TAROM three zero one, taxi to holding point runway zero eight right via Alpha.'],
  ['ROT301', 'Taxi holding point zero eight right via Alpha, TAROM three zero one.'],
];

const C = {
  en: {
    label: 'AI_ATC product tour',
    steps: [
      {
        tab: 'Radio portal',
        title: 'Talk to the tower like a real pilot',
        points: [
          'A live map of your aircraft, airports, runways and traffic, with the current weather.',
          'Press and talk: the controller hears you and answers in seconds.',
          'Two radios with active and standby frequencies, just like the cockpit.',
          'Every exchange is written down in the conversation log.',
        ],
      },
      {
        tab: 'Flight plan',
        title: 'Plan the flight in a minute',
        points: [
          'Load your flight plan from SimBrief with your pilot ID, or upload one.',
          'Pick the runway, departure, arrival and approach.',
          'File the plan; the controllers expect you from then on.',
          'See the route drawn on the map.',
        ],
      },
      {
        tab: 'In the cockpit',
        title: 'Stay in the cockpit the whole time',
        points: [
          'Push-to-talk from your yoke or joystick button.',
          'The controller’s voice plays through the aircraft’s COM1 radio, in your headset.',
          'A small status panel inside the simulator shows who you are talking to.',
        ],
      },
      {
        tab: 'Flight progress',
        title: 'Guided from gate to gate',
        points: [
          'A checklist of every phase, from clearance to landing, ticked as you fly.',
          'A hint tells you what to do next and who to call.',
          'Five controllers hand you over by flight phase, as in real life.',
          'Choose how busy the sky is, or watch a full flight in demo mode.',
        ],
      },
    ],
    ui: {
      title: 'AI-ATC · X-Plane 12',
      model: 'Model: qwen 3.5',
      conn: 'Connected',
      menu: ['File', 'View', 'Services', 'Settings', 'Help'],
      map: ['Follow', 'Airports', 'Traffic'],
      wx: '24 °C · 070/08 kt · 10 km · QNH 1016',
      ptt: 'Push to Talk',
      type: 'Type a message…',
      active: 'ACTIVE',
      standby: 'STBY',
      log: 'Conversation log',
      callsign: 'Callsign',
      aircraft: 'Aircraft',
      ptabs: ['SimBrief', 'Upload', 'Fleet', 'Saved', 'History'],
      pilot: 'Pilot ID',
      load: 'Load',
      route: 'LROP → LBSF',
      pickers: [
        ['Runway', '08R'],
        ['Departure', 'as filed'],
        ['Arrival', 'as filed'],
        ['Approach', 'ILS 09'],
      ],
      file: 'File plan',
      show: 'Show route',
      yoke: 'PTT',
      speaking: 'Tower speaking…',
      status: 'AI-ATC · Tower · 118.805',
      progress: 'Flight progress',
      phases: [
        ['Parked', 'Clearance'],
        ['Pushback', 'Ground'],
        ['Taxi', 'Ground'],
        ['Take-off', 'Tower'],
        ['Departure', 'Approach'],
        ['Cruise', 'Center'],
        ['Descent', 'Center'],
        ['Approach', 'Approach'],
        ['Landing', 'Tower'],
      ],
      next: 'Next: request taxi from Ground on 121.855',
      traffic: 'Traffic',
      modes: ['Solo', 'Light', 'Moderate', 'Busy'],
      demo: 'Demo mode',
      engine: 'ATC engine',
      engines: ['Rules', 'Free AI'],
    },
  },
  ro: {
    label: 'Turul produsului AI_ATC',
    steps: [
      {
        tab: 'Portalul radio',
        title: 'Vorbești cu turnul ca un pilot adevărat',
        points: [
          'O hartă live cu aeronava, aeroporturile, pistele și traficul, plus vremea curentă.',
          'Apeși și vorbești: controlorul te aude și răspunde în câteva secunde.',
          'Două stații radio cu frecvențe active și de rezervă, exact ca în cabină.',
          'Fiecare schimb de replici este notat în jurnalul conversației.',
        ],
      },
      {
        tab: 'Plan de zbor',
        title: 'Planifici zborul într-un minut',
        points: [
          'Încarci planul de zbor din SimBrief cu ID-ul de pilot sau îl încarci din fișier.',
          'Alegi pista, plecarea, sosirea și apropierea.',
          'Depui planul; de acum controlorii te așteaptă.',
          'Vezi ruta desenată pe hartă.',
        ],
      },
      {
        tab: 'În cabină',
        title: 'Rămâi în cabină tot timpul',
        points: [
          'Apeși butonul de transmisie de pe manșă sau joystick.',
          'Vocea controlorului se aude prin stația COM1 a aeronavei, în căști.',
          'Un mic panou în simulator arată cu cine vorbești.',
        ],
      },
      {
        tab: 'Progresul zborului',
        title: 'Ghidat de la poartă la poartă',
        points: [
          'O listă cu fiecare fază, de la autorizare la aterizare, bifată pe măsură ce zbori.',
          'Un indiciu îți spune ce urmează și pe cine să apelezi.',
          'Cinci controlori te predau unul altuia după faza de zbor, ca în realitate.',
          'Alegi cât de aglomerat e cerul sau urmărești un zbor complet în modul demo.',
        ],
      },
    ],
    ui: {
      title: 'AI-ATC · X-Plane 12',
      model: 'Model: qwen 3.5',
      conn: 'Conectat',
      menu: ['Fișier', 'Vizualizare', 'Servicii', 'Setări', 'Ajutor'],
      map: ['Urmărește', 'Aeroporturi', 'Trafic'],
      wx: '24 °C · 070/08 kt · 10 km · QNH 1016',
      ptt: 'Apasă și vorbește',
      type: 'Scrie un mesaj…',
      active: 'ACTIV',
      standby: 'REZ.',
      log: 'Jurnalul conversației',
      callsign: 'Indicativ',
      aircraft: 'Aeronavă',
      ptabs: ['SimBrief', 'Încarcă', 'Flotă', 'Salvate', 'Istoric'],
      pilot: 'ID pilot',
      load: 'Încarcă',
      route: 'LROP → LBSF',
      pickers: [
        ['Pistă', '08R'],
        ['Plecare', 'conform planului'],
        ['Sosire', 'conform planului'],
        ['Apropiere', 'ILS 09'],
      ],
      file: 'Depune planul',
      show: 'Arată ruta',
      yoke: 'PTT',
      speaking: 'Vorbește turnul…',
      status: 'AI-ATC · Turn · 118.805',
      progress: 'Progresul zborului',
      phases: [
        ['Parcat', 'Autorizare'],
        ['Împingere', 'Sol'],
        ['Rulare', 'Sol'],
        ['Decolare', 'Turn'],
        ['Plecare', 'Apropiere'],
        ['Croazieră', 'Control regional'],
        ['Coborâre', 'Control regional'],
        ['Apropiere', 'Apropiere'],
        ['Aterizare', 'Turn'],
      ],
      next: 'Urmează: cere rularea de la Sol pe 121.855',
      traffic: 'Trafic',
      modes: ['Singur', 'Ușor', 'Moderat', 'Aglomerat'],
      demo: 'Mod demo',
      engine: 'Motor ATC',
      engines: ['Reguli', 'AI liber'],
    },
  },
}[lang];
const u = C.ui;
---

<TourFrame lang={lang} label={C.label} steps={C.steps} url="ai-atc.local:4991">
  <!-- 1 · Portal -->
  <div data-screen aria-hidden="true" class="at">
    <header class="ah">
      <b>{u.title}</b>
      <span class="chip2">{u.model}</span>
      <span class="ok"><i></i>{u.conn}</span>
    </header>
    <nav class="menu">{u.menu.map((m) => <span>{m}</span>)}</nav>
    <div class="cols3">
      <div class="card mapc">
        <div class="tgl">{u.map.map((m) => <span class="on">{m}</span>)}</div>
        <svg viewBox="0 0 360 330" class="amap">
          <rect width="360" height="330" rx="8" fill="#161622" />
          {[60, 120, 180, 240, 300].map((x) => <line x1={x} x2={x} y1="0" y2="330" stroke="#26263a" />)}
          {[60, 120, 180, 240].map((y) => <line x1="0" x2="360" y1={y} y2={y} stroke="#26263a" />)}
          <g transform="rotate(-8 180 170)">
            <rect x="110" y="150" width="140" height="8" fill="#9e9eb0" />
            <rect x="110" y="182" width="140" height="8" fill="#9e9eb0" />
            <rect x="130" y="158" width="6" height="24" fill="#4a4a66" />
            <rect x="220" y="158" width="6" height="24" fill="#4a4a66" />
          </g>
          <path d="M226 212 l10 -4 l-2 8 z" fill="#60a5fa" />
          <circle cx="70" cy="80" r="5" fill="#34d399" />
          <circle cx="300" cy="260" r="5" fill="#34d399" />
          <path d="M290 60 l8 -3 l-1 6 z" fill="#fbbf24" />
          <path d="M60 250 l8 -3 l-1 6 z" fill="#fbbf24" />
        </svg>
        <p class="wx">{u.wx}</p>
        <p class="metar">LROP 260750Z 07008KT 9999 FEW040 24/11 Q1016</p>
      </div>
      <div class="card radio">
        <div class="ptt"><span>🎙</span>{u.ptt}</div>
        <p class="typein">{u.type}</p>
        <div class="coms">
          <div class="com">
            <b>COM1</b>
            <span>
              <small>{u.active}</small>118.805
            </span>
            <em>⇄</em>
            <span>
              <small>{u.standby}</small>121.855
            </span>
          </div>
          <div class="com dim">
            <b>COM2</b>
            <span>
              <small>{u.active}</small>122.800
            </span>
            <em>⇄</em>
            <span>
              <small>{u.standby}</small>120.600
            </span>
          </div>
        </div>
      </div>
      <div class="card logc">
        <h6>{u.log}</h6>
        {log.map(([who, text]) => (
          <p class:list={['msg', who === 'GND' && 'atc']} lang="en">
            <b>{who}</b>
            {text}
          </p>
        ))}
      </div>
    </div>
    <span class="co" style="--x:6%;--y:30%">1</span>
    <span class="co" style="--x:50%;--y:24%">2</span>
    <span class="co" style="--x:44%;--y:66%">3</span>
    <span class="co" style="--x:70%;--y:24%">4</span>
  </div>

  <!-- 2 · Flight plan -->
  <div data-screen aria-hidden="true" class="at">
    <header class="ah">
      <b>{u.title}</b>
      <span class="chip2">{u.model}</span>
      <span class="ok"><i></i>{u.conn}</span>
    </header>
    <div class="plan">
      <div class="card mapc">
        <svg viewBox="0 0 520 420" class="amap">
          <rect width="520" height="420" rx="8" fill="#161622" />
          {[80, 160, 240, 320, 400, 480].map((x) => <line x1={x} x2={x} y1="0" y2="420" stroke="#26263a" />)}
          {[80, 160, 240, 320].map((y) => <line x1="0" x2="520" y1={y} y2={y} stroke="#26263a" />)}
          <path d="M120 120 Q200 150 260 210 T410 320" fill="none" stroke="#60a5fa" stroke-width="3" stroke-dasharray="8 6" class="route" />
          <circle cx="120" cy="120" r="7" fill="#60a5fa" />
          <circle cx="410" cy="320" r="7" fill="#60a5fa" />
          <text x="100" y="105" fill="#e4e4e8" font-size="13">LROP</text>
          <text x="392" y="350" fill="#e4e4e8" font-size="13">LBSF</text>
        </svg>
      </div>
      <div class="card fp">
        <div class="two">
          <label>
            {u.callsign}
            <span class="field">ROT301</span>
          </label>
          <label>
            {u.aircraft}
            <span class="field">A320</span>
          </label>
        </div>
        <div class="ptabs">{u.ptabs.map((t, i) => <span class:list={[i === 0 && 'on']}>{t}</span>)}</div>
        <div class="two">
          <label>
            {u.pilot}
            <span class="field">••••••</span>
          </label>
          <span class="btnb">{u.load}</span>
        </div>
        <p class="rt">{u.route}</p>
        {u.pickers.map(([k, v]) => (
          <div class="pick">
            <span>{k}</span>
            <b>{v} ▾</b>
          </div>
        ))}
        <div class="two">
          <span class="btnb">{u.file}</span>
          <span class="btnl">{u.show}</span>
        </div>
      </div>
    </div>
    <span class="co" style="--x:63%;--y:34%">1</span>
    <span class="co" style="--x:63%;--y:58%">2</span>
    <span class="co" style="--x:63%;--y:74%">3</span>
    <span class="co" style="--x:30%;--y:44%">4</span>
  </div>

  <!-- 3 · Cockpit -->
  <div data-screen aria-hidden="true" class="at cockpit">
    <div class="panel">
      <p class="pl">COM1</p>
      <div class="lcd">
        <span>118.805</span>
        <span class="sb">121.855</span>
      </div>
      <p class="pl">COM2</p>
      <div class="lcd dim">
        <span>122.800</span>
        <span class="sb">120.600</span>
      </div>
    </div>
    <div class="yoke">
      <svg viewBox="0 0 320 200">
        <path d="M20 60 Q20 20 60 20 L260 20 Q300 20 300 60 L300 110 Q300 140 270 140 L200 140 L180 190 L140 190 L120 140 L50 140 Q20 140 20 110 Z" fill="#2d2d3f" stroke="#4a4a66" stroke-width="3" />
        <circle cx="62" cy="60" r="16" fill="#60a5fa" class="pttb" />
        <text x="62" y="65" text-anchor="middle" font-size="12" fill="#0b1020" font-weight="700">{u.yoke}</text>
      </svg>
    </div>
    <div class="head">
      <span class="hs">🎧</span>
      <div class="wave">{Array.from({ length: 22 }, (_, i) => <i style={`--i:${i}`} />)}</div>
      <p>{u.speaking}</p>
    </div>
    <div class="insim">{u.status}</div>
    <span class="co" style="--x:22%;--y:48%">1</span>
    <span class="co" style="--x:74%;--y:30%">2</span>
    <span class="co" style="--x:74%;--y:86%">3</span>
  </div>

  <!-- 4 · Flight progress -->
  <div data-screen aria-hidden="true" class="at">
    <header class="ah">
      <b>{u.title}</b>
      <span class="chip2">{u.model}</span>
      <span class="ok"><i></i>{u.conn}</span>
    </header>
    <div class="prog">
      <div class="card list">
        <h6>{u.progress}</h6>
        <div class="bar2"><span style="width:30%" /></div>
        {u.phases.map(([p, c], i) => (
          <p class:list={['ph', i < 2 ? 'done' : i === 2 ? 'now' : '']}>
            <span>{i < 2 ? '✓' : i === 2 ? '●' : '○'}</span>
            {p}
            <em>{c}</em>
          </p>
        ))}
      </div>
      <div class="side2">
        <div class="card hint">💡 {u.next}</div>
        <div class="card">
          <h6>{u.traffic}</h6>
          <div class="seg2">{u.modes.map((m, i) => <span class:list={[i === 2 && 'on']}>{m}</span>)}</div>
          <h6>{u.engine}</h6>
          <div class="seg2">{u.engines.map((m, i) => <span class:list={[i === 0 && 'on']}>{m}</span>)}</div>
          <p class="demo">
            <span class="tg2 on"><i /></span>
            {u.demo}
          </p>
        </div>
      </div>
    </div>
    <span class="co" style="--x:6%;--y:24%">1</span>
    <span class="co" style="--x:54%;--y:22%">2</span>
    <span class="co" style="--x:41%;--y:40%">3</span>
    <span class="co" style="--x:66%;--y:30%">4</span>
  </div>
</TourFrame>

<style>
  .at {
    background: #1e1e2e;
    color: #e4e4e8;
    font-family: var(--font-sans);
    font-size: 13px;
    overflow: hidden;
  }
  .ah {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 46px;
    padding: 0 18px;
    background: #25253a;
  }
  .ah b {
    font-size: 15px;
  }
  .chip2 {
    padding: 3px 10px;
    border-radius: 999px;
    background: #2d2d3f;
    color: #9e9eb0;
    font-size: 11px;
  }
  .ok {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #34d399;
    font-size: 12px;
  }
  .ok i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #34d399;
  }
  .menu {
    display: flex;
    gap: 18px;
    padding: 6px 18px;
    border-bottom: 1px solid #2d2d3f;
    color: #9e9eb0;
    font-size: 12px;
  }
  .cols3 {
    display: grid;
    grid-template-columns: 380px 1fr 300px;
    gap: 12px;
    padding: 12px;
  }
  .card {
    background: #2d2d3f;
    border-radius: 12px;
    padding: 12px;
  }
  .tgl {
    display: flex;
    gap: 6px;
    margin-bottom: 8px;
  }
  .tgl span {
    padding: 3px 9px;
    border-radius: 999px;
    background: #1e1e2e;
    font-size: 11px;
    color: #60a5fa;
  }
  .amap {
    width: 100%;
    height: auto;
  }
  .wx {
    margin-top: 8px;
    font-size: 12px;
  }
  .metar {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: #9e9eb0;
  }
  .radio {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .ptt {
    display: grid;
    place-items: center;
    width: 150px;
    height: 150px;
    margin-top: 8px;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 35%, #7cb6fb, #2563eb);
    box-shadow: 0 0 0 10px rgb(96 165 250 / 0.15);
    font-weight: 700;
    text-align: center;
    font-size: 13px;
    line-height: 1.3;
    animation: ptt 2.4s ease-in-out infinite;
  }
  .ptt span {
    font-size: 30px;
  }
  @keyframes ptt {
    50% {
      box-shadow: 0 0 0 22px rgb(96 165 250 / 0.06);
    }
  }
  .typein {
    width: 100%;
    margin-top: 14px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #1e1e2e;
    color: #9e9eb0;
    font-size: 12px;
  }
  .coms {
    width: 100%;
    margin-top: 12px;
    display: grid;
    gap: 8px;
  }
  .com {
    display: grid;
    grid-template-columns: 46px 1fr 20px 1fr;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 8px;
    background: #1e1e2e;
  }
  .com span {
    font-family: var(--font-mono);
    font-size: 15px;
    color: #fbbf24;
  }
  .com small {
    display: block;
    font-family: var(--font-sans);
    font-size: 9px;
    color: #9e9eb0;
  }
  .com em {
    font-style: normal;
    color: #60a5fa;
  }
  .com.dim span {
    color: #9e9eb0;
  }
  h6 {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #9e9eb0;
    margin: 4px 0 10px;
  }
  .msg {
    padding: 8px 10px;
    margin-bottom: 8px;
    border-radius: 8px;
    background: #1e1e2e;
    font-size: 12px;
    line-height: 1.45;
  }
  .msg b {
    display: block;
    font-size: 10px;
    color: #9e9eb0;
  }
  .msg.atc {
    border-left: 3px solid #60a5fa;
  }
  .msg.atc b {
    color: #60a5fa;
  }
  .plan {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 12px;
    padding: 12px;
  }
  .route {
    animation: dash 3s linear infinite;
  }
  @keyframes dash {
    to {
      stroke-dashoffset: -56;
    }
  }
  .two {
    display: flex;
    gap: 10px;
    align-items: flex-end;
    margin-bottom: 10px;
  }
  .two label {
    flex: 1;
    font-size: 11px;
    color: #9e9eb0;
  }
  .field {
    display: block;
    margin-top: 4px;
    padding: 7px 10px;
    border-radius: 8px;
    background: #1e1e2e;
    color: #e4e4e8;
    font-family: var(--font-mono);
    font-size: 13px;
  }
  .ptabs {
    display: flex;
    gap: 4px;
    margin-bottom: 10px;
  }
  .ptabs span {
    padding: 5px 9px;
    border-radius: 6px;
    font-size: 11px;
    color: #9e9eb0;
  }
  .ptabs .on {
    background: #60a5fa;
    color: #0b1020;
  }
  .btnb {
    padding: 8px 14px;
    border-radius: 8px;
    background: #60a5fa;
    color: #0b1020;
    font-weight: 700;
    font-size: 12px;
  }
  .btnl {
    padding: 8px 14px;
    border-radius: 8px;
    border: 1px solid #4a4a66;
    font-size: 12px;
  }
  .rt {
    font-family: var(--font-mono);
    font-size: 16px;
    margin: 6px 0 10px;
  }
  .pick {
    display: flex;
    justify-content: space-between;
    padding: 7px 10px;
    margin-bottom: 6px;
    border-radius: 8px;
    background: #1e1e2e;
    font-size: 12px;
  }
  .pick b {
    color: #60a5fa;
  }
  .cockpit {
    background: radial-gradient(80% 80% at 50% 30%, #2a2a40, #121220);
  }
  .panel {
    position: absolute;
    left: 520px;
    top: 60px;
    width: 400px;
    padding: 18px;
    border-radius: 10px;
    background: #111118;
    border: 2px solid #33334a;
  }
  .pl {
    font-size: 11px;
    color: #9e9eb0;
    letter-spacing: 2px;
  }
  .lcd {
    display: flex;
    justify-content: space-between;
    margin: 6px 0 12px;
    padding: 10px 14px;
    background: #050508;
    font-family: var(--font-mono);
