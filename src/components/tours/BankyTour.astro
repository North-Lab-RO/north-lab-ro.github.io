---
import TourFrame from './TourFrame.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const money = (n: number) =>
  new Intl.NumberFormat(lang === 'ro' ? 'ro-RO' : 'en-GB', { minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(n);

const C = {
  en: {
    label: 'BANKY product tour',
    steps: [
      {
        tab: 'Dashboard',
        title: 'All your money, at a glance',
        points: [
          'Balance, income, spending and savings for the month, per currency.',
          'Where the money went, by category.',
          'Spending month by month.',
          'The latest transactions, already categorised.',
        ],
      },
      {
        tab: 'Import review',
        title: 'Import a statement, check it, done',
        points: [
          'The original statement stays beside the rows it produced, so you can check any line.',
          'Each row arrives with a suggested category and how sure the system is.',
          'Possible duplicates are flagged before they reach your accounts.',
          'Confirm all the clean rows at once. Nothing is saved until you do.',
        ],
      },
      {
        tab: 'Transactions',
        title: 'Find any payment in seconds',
        points: [
          'Search the way you think: a shop name and an amount, like “Lidl >100”.',
          'Filter by account, category and dates.',
          'Categorise many transactions at once.',
        ],
      },
      {
        tab: 'Budgets',
        title: 'Know where you stand before the month ends',
        points: [
          'Monthly limits per category, with what is left.',
          'The 50/30/20 view: needs, wants and what you keep.',
        ],
      },
      {
        tab: 'Goals & investments',
        title: 'Save towards something, and watch it grow',
        points: ['Goals with a target, a date and your progress.', 'Investments: what they are worth, what you put in, what you gained.'],
      },
      {
        tab: 'Receipts',
        title: 'Every item on the receipt, not just the total',
        points: [
          'Photograph a receipt and it is read on your computer.',
          'Every product becomes a line you can categorise.',
          'The lines are checked against the receipt’s total.',
        ],
      },
      {
        tab: 'Monthly report',
        title: 'A report you can print or share',
        points: ['The month in a few numbers.', 'Spending by category, compared with your budget.', 'Ready to print, or to save as PDF.'],
      },
    ],
    ui: {
      nav: ['Dashboard', 'Transactions', 'Accounts', 'Analytics', 'Budgets', 'Goals', 'Investments', 'AI insights', 'Imports', 'Receipts', 'Reports', 'Settings'],
      sub: 'Local ledger',
      cards: ['Total balance', 'Income', 'Spent', 'Saved this month'],
      byCat: 'Spending by category',
      monthly: 'Monthly spending',
      recent: 'Recent transactions',
      months: ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep'],
      tx: [
        ['26 Sep', 'Supermarket', 'Groceries', -214.3],
        ['25 Sep', 'Salary', 'Income', 9800],
        ['24 Sep', 'Electricity', 'Utilities', -186.5],
        ['23 Sep', 'Pharmacy', 'Health', -62.9],
      ],
      cats: ['Housing', 'Groceries', 'Transport', 'Health', 'Leisure'],
      file: 'statement-september.pdf',
      confirm: 'Confirm 37 clean rows',
      reject: 'Reject selected',
      yourRule: 'your rule',
      unsure: 'unsure',
      dup: 'possible duplicate',
      rows: [
        ['03.09', 'Rent transfer', -1284.5, 'Housing', 98, 'rule'],
        ['05.09', 'Supermarket', -62.9, 'Groceries', 94, ''],
        ['08.09', 'Online order', -219.99, 'Leisure', 61, 'unsure'],
        ['08.09', 'Online order', -219.99, 'Leisure', 61, 'dup'],
        ['11.09', 'Salary', 4500, 'Income', 99, 'rule'],
      ],
      search: 'Lidl >100',
      filters: ['Account: all', 'Category: all', 'September'],
      selected: '3 selected',
      categorise: 'Categorise',
      analyse: 'Suggest categories',
      budgets: 'Budgets · September',
      budgetRows: [
        ['Groceries', 1210, 1500],
        ['Transport', 420, 500],
        ['Leisure', 610, 600],
        ['Utilities', 380, 450],
      ],
      left: 'left',
      over: 'over',
      rule: 'Needs, wants and what is left',
      split: [
        ['Needs', 52, 50],
        ['Wants', 31, 30],
        ['Saved', 17, 20],
      ],
      goals: 'Goals',
      goalRows: [
        ['Emergency fund', 62, 'Mar 2027'],
        ['Holiday', 40, 'Jul 2027'],
      ],
      invest: 'Investments',
      invCols: ['', 'Worth', 'Put in', 'Gain'],
      invRows: [
        ['Index fund', 12450, 11000],
        ['Government bonds', 8200, 8000],
      ],
      receipt: 'RECEIPT',
      items: [
        ['Bread', 1, 6.5],
        ['Milk 1L', 2, 15.8],
        ['Apples 1kg', 1, 7.9],
        ['Coffee 250g', 1, 24.9],
      ],
      total: 'Total',
      matches: '✓ matches the receipt total',
      itemCols: ['Product', 'Qty', 'Price'],
      report: 'Monthly report · September 2026',
      repNums: [
        ['Income', 9800],
        ['Spent', 6214.3],
        ['Saved', 3585.7],
      ],
      repTable: 'By category',
      print: '⎙ Print',
    },
  },
  ro: {
    label: 'Turul produsului BANKY',
    steps: [
      {
        tab: 'Panou principal',
        title: 'Toți banii tăi, dintr-o privire',
        points: [
          'Soldul, veniturile, cheltuielile și economiile lunii, pe fiecare monedă.',
          'Unde s-au dus banii, pe categorii.',
          'Cheltuielile, lună de lună.',
          'Ultimele tranzacții, deja clasificate.',
        ],
      },
      {
        tab: 'Revizuire import',
        title: 'Imporți un extras, îl verifici, gata',
        points: [
          'Extrasul original stă lângă rândurile extrase din el, ca să poți verifica orice linie.',
          'Fiecare rând vine cu o categorie propusă și cât de sigur este sistemul.',
          'Posibilele duplicate sunt semnalate înainte să ajungă în conturi.',
          'Confirmi dintr-odată toate rândurile curate. Nimic nu se salvează până nu confirmi.',
        ],
      },
      {
        tab: 'Tranzacții',
        title: 'Găsești orice plată în câteva secunde',
        points: [
          'Cauți cum gândești: numele magazinului și o sumă, de exemplu „Lidl >100”.',
          'Filtrezi după cont, categorie și perioadă.',
          'Clasifici multe tranzacții dintr-odată.',
        ],
      },
      {
        tab: 'Bugete',
        title: 'Știi unde ești înainte să se termine luna',
        points: ['Limite lunare pe categorii, cu ce a mai rămas.', 'Vederea 50/30/20: nevoi, dorințe și ce păstrezi.'],
      },
      {
        tab: 'Obiective și investiții',
        title: 'Economisești pentru ceva și vezi cum crește',
        points: ['Obiective cu o țintă, o dată și progresul tău.', 'Investiții: cât valorează, cât ai pus, cât ai câștigat.'],
      },
      {
        tab: 'Bonuri',
        title: 'Fiecare produs de pe bon, nu doar totalul',
        points: [
          'Fotografiezi un bon și este citit pe calculatorul tău.',
          'Fiecare produs devine o linie pe care o poți clasifica.',
          'Liniile sunt verificate față de totalul bonului.',
        ],
      },
      {
        tab: 'Raport lunar',
        title: 'Un raport pe care îl tipărești sau îl trimiți',
        points: ['Luna în câteva cifre.', 'Cheltuielile pe categorii, comparate cu bugetul.', 'Gata de tipărit sau de salvat ca PDF.'],
      },
    ],
    ui: {
      nav: ['Panou', 'Tranzacții', 'Conturi', 'Analize', 'Bugete', 'Obiective', 'Investiții', 'Observații AI', 'Importuri', 'Bonuri', 'Rapoarte', 'Setări'],
      sub: 'Registru local',
      cards: ['Sold total', 'Venituri', 'Cheltuit', 'Economisit luna asta'],
      byCat: 'Cheltuieli pe categorii',
      monthly: 'Cheltuieli lunare',
      recent: 'Tranzacții recente',
      months: ['apr', 'mai', 'iun', 'iul', 'aug', 'sep'],
      tx: [
        ['26 sep', 'Supermarket', 'Alimente', -214.3],
        ['25 sep', 'Salariu', 'Venit', 9800],
        ['24 sep', 'Energie electrică', 'Utilități', -186.5],
        ['23 sep', 'Farmacie', 'Sănătate', -62.9],
      ],
      cats: ['Locuință', 'Alimente', 'Transport', 'Sănătate', 'Timp liber'],
      file: 'extras-septembrie.pdf',
      confirm: 'Confirmă 37 de rânduri curate',
      reject: 'Respinge selecția',
      yourRule: 'regula ta',
      unsure: 'nesigur',
      dup: 'posibil duplicat',
      rows: [
        ['03.09', 'Transfer chirie', -1284.5, 'Locuință', 98, 'rule'],
        ['05.09', 'Supermarket', -62.9, 'Alimente', 94, ''],
        ['08.09', 'Comandă online', -219.99, 'Timp liber', 61, 'unsure'],
        ['08.09', 'Comandă online', -219.99, 'Timp liber', 61, 'dup'],
        ['11.09', 'Salariu', 4500, 'Venit', 99, 'rule'],
      ],
      search: 'Lidl >100',
      filters: ['Cont: toate', 'Categorie: toate', 'Septembrie'],
      selected: '3 selectate',
      categorise: 'Clasifică',
      analyse: 'Propune categorii',
      budgets: 'Bugete · septembrie',
      budgetRows: [
        ['Alimente', 1210, 1500],
        ['Transport', 420, 500],
        ['Timp liber', 610, 600],
        ['Utilități', 380, 450],
      ],
      left: 'rămas',
      over: 'depășit',
      rule: 'Nevoi, dorințe și ce rămâne',
      split: [
        ['Nevoi', 52, 50],
        ['Dorințe', 31, 30],
        ['Economii', 17, 20],
      ],
      goals: 'Obiective',
      goalRows: [
        ['Fond de urgență', 62, 'mar. 2027'],
        ['Vacanță', 40, 'iul. 2027'],
      ],
      invest: 'Investiții',
      invCols: ['', 'Valoare', 'Investit', 'Câștig'],
      invRows: [
        ['Fond indexat', 12450, 11000],
        ['Titluri de stat', 8200, 8000],
      ],
      receipt: 'BON FISCAL',
      items: [
        ['Pâine', 1, 6.5],
        ['Lapte 1L', 2, 15.8],
        ['Mere 1kg', 1, 7.9],
        ['Cafea 250g', 1, 24.9],
      ],
      total: 'Total',
      matches: '✓ corespunde totalului de pe bon',
      itemCols: ['Produs', 'Cant.', 'Preț'],
      report: 'Raport lunar · septembrie 2026',
      repNums: [
        ['Venituri', 9800],
        ['Cheltuit', 6214.3],
        ['Economisit', 3585.7],
      ],
      repTable: 'Pe categorii',
      print: '⎙ Tipărește',
    },
  },
}[lang];
const u = C.ui;
const cardVals = [18420.55, 9800, 6214.3, 3585.7];
const donut = [
  [34, '#d8a75a'],
  [22, '#7fa6c9'],
  [14, '#8fbf9a'],
  [9, '#c98f7f'],
  [21, '#a99bd6'],
] as const;
let acc = 0;
const arcs = donut.map(([p, c]) => {
  const start = acc;
  acc += p;
  return { p, c, start };
});
const bars = [5200, 5900, 6800, 5600, 6400, 6214];
const itemsTotal = u.items.reduce((s, [, , p]) => s + Number(p), 0);
const nav = (active: number) => u.nav.map((n, i) => ({ n, on: i === active }));
---

<TourFrame lang={lang} label={C.label} steps={C.steps} url="banky.local">
  <!-- 1 · Dashboard -->
  <div data-screen aria-hidden="true" class="bk">
    <aside class="sb">
      <p class="logo">Banky<small>{u.sub}</small></p>
      {nav(0).map(({ n, on }) => <p class:list={['ni', on && 'on']}>{n}</p>)}
    </aside>
    <main class="mn">
      <p class="cur">RON</p>
      <div class="cards">
        {u.cards.map((c, i) => (
          <div class="card">
            <span>{c}</span>
            <b class:list={['num', i === 2 && 'neg', i === 3 && 'pos']}>{money(cardVals[i])}</b>
          </div>
        ))}
      </div>
      <div class="two">
        <div class="box">
          <h6>{u.byCat}</h6>
          <div class="donutrow">
            <svg viewBox="0 0 42 42" class="donut">
              {arcs.map(({ p, c, start }) => (
                <circle cx="21" cy="21" r="15.9" fill="none" stroke={c} stroke-width="6" stroke-dasharray={`${p} ${100 - p}`} stroke-dashoffset={25 - start} />
              ))}
            </svg>
            <ul class="legend">
              {u.cats.map((c, i) => (
                <li>
                  <i style={`background:${donut[i][1]}`} />
                  {c}
                  <em>{donut[i][0]}%</em>
                </li>
              ))}
            </ul>
          </div>
        </div>
        <div class="box">
          <h6>{u.monthly}</h6>
          <div class="bars">
            {bars.map((b, i) => (
              <div class="barc">
                <span style={`height:${(b / 7000) * 120}px`} class:list={[i === 5 && 'now']} />
                <em>{u.months[i]}</em>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="box">
        <h6>{u.recent}</h6>
        {u.tx.map(([d, n, c, a]) => (
          <p class="tx">
            <span>{d}</span>
            <span>{n}</span>
            <span class="cat">{c}</span>
            <b class:list={['num', Number(a) < 0 ? 'neg' : 'pos']}>{money(Number(a))}</b>
          </p>
        ))}
      </div>
    </main>
    <span class="co" style="--x:30%;--y:13%">1</span>
    <span class="co" style="--x:30%;--y:38%">2</span>
    <span class="co" style="--x:66%;--y:38%">3</span>
    <span class="co" style="--x:30%;--y:74%">4</span>
  </div>

  <!-- 2 · Import review -->
  <div data-screen aria-hidden="true" class="bk">
    <aside class="sb">
      <p class="logo">Banky<small>{u.sub}</small></p>
      {nav(8).map(({ n, on }) => <p class:list={['ni', on && 'on']}>{n}</p>)}
    </aside>
    <main class="mn review">
      <div class="doc">
        <p class="docname">📄 {u.file}</p>
        <div class="page">
          {u.rows.slice(0, 4).map(([d, n, a], i) => (
            <p class:list={['dl', i === 2 && 'hl']}>
              <span>{d}</span>
              <i />
              <b>{money(Math.abs(Number(a)))}</b>
            </p>
          ))}
          <p class="dl">
            <span>11.09</span>
            <i />
            <b>{money(4500)}</b>
          </p>
          {Array.from({ length: 6 }, () => (
            <p class="dl ghost">
              <span>··.··</span>
              <i />
              <b>···,··</b>
            </p>
          ))}
        </div>
      </div>
      <div class="rows">
        <div class="rtop">
          <span class="gold">{u.confirm}</span>
          <span class="outline">{u.reject}</span>
        </div>
        {u.rows.map(([d, n, a, c, conf, tag], i) => (
          <div class:list={['rr', tag === 'dup' && 'dupr', i === 2 && 'hl']}>
            <span class="dd">{d}</span>
            <span>{n}</span>
            <b class:list={['num', Number(a) < 0 ? 'neg' : 'pos']}>{money(Number(a))}</b>
            <span class="sug">
              {c} <em>{conf}%</em>
            </span>
            <span class="tags">
              {tag === 'rule' && <i class="t-rule">{u.yourRule}</i>}
              {tag === 'unsure' && <i class="t-uns">{u.unsure}</i>}
              {tag === 'dup' && <i class="t-dup">⚠ {u.dup}</i>}
            </span>
          </div>
        ))}
      </div>
    </main>
    <span class="co" style="--x:27%;--y:12%">1</span>
    <span class="co" style="--x:86%;--y:30%">2</span>
    <span class="co" style="--x:86%;--y:55%">3</span>
    <span class="co" style="--x:58%;--y:9%">4</span>
  </div>

  <!-- 3 · Transactions -->
  <div data-screen aria-hidden="true" class="bk">
    <aside class="sb">
      <p class="logo">Banky<small>{u.sub}</small></p>
      {nav(1).map(({ n, on }) => <p class:list={['ni', on && 'on']}>{n}</p>)}
    </aside>
    <main class="mn">
      <div class="search">🔍 <b>{u.search}</b></div>
      <div class="filters">{u.filters.map((f) => <span>{f} ▾</span>)}</div>
      <div class="bulk">
        <span>{u.selected}</span>
        <span class="gold">{u.categorise}</span>
        <span class="outline">✨ {u.analyse}</span>
      </div>
      {[
        ['24 sep', 'Lidl', u.cats[1], -186.4, true],
        ['17 sep', 'Lidl', u.cats[1], -142.9, true],
        ['09 sep', 'Lidl', u.cats[1], -121.35, true],
        ['02 sep', 'Lidl', u.cats[1], -104.2, false],
      ].map(([d, n, c, a, sel]) => (
        <p class:list={['tx', 'sel-row', sel && 'sel']}>
          <span class="ck">{sel ? '☑' : '☐'}</span>
          <span>{d}</span>
          <span>{n}</span>
          <span class="cat">{c}</span>
          <b class="num neg">{money(Number(a))}</b>
        </p>
      ))}
    </main>
    <span class="co" style="--x:30%;--y:8%">1</span>
    <span class="co" style="--x:30%;--y:19%">2</span>
    <span class="co" style="--x:30%;--y:31%">3</span>
  </div>

  <!-- 4 · Budgets -->
  <div data-screen aria-hidden="true" class="bk">
    <aside class="sb">
      <p class="logo">Banky<small>{u.sub}</small></p>
      {nav(4).map(({ n, on }) => <p class:list={['ni', on && 'on']}>{n}</p>)}
    </aside>
    <main class="mn">
      <div class="two">
        <div class="box">
          <h6>{u.budgets}</h6>
          {u.budgetRows.map(([c, s, l]) => {
            const pct = Math.min(100, (Number(s) / Number(l)) * 100);
            const over = Number(s) > Number(l);
            return (
              <div class="bud">
                <p>
                  <span>{c}</span>
                  <b class="num">
                    {money(Number(s))} / {money(Number(l))}
                  </b>
                </p>
                <div class="track">
                  <span class:list={[over && 'over']} style={`width:${pct}%`} />
                </div>
                <em class:list={[over && 'overt']}>
                  {over ? `${money(Number(s) - Number(l))} ${u.over}` : `${money(Number(l) - Number(s))} ${u.left}`}
                </em>
              </div>
            );
          })}
        </div>
        <div class="box">
          <h6>{u.rule}</h6>
          {u.split.map(([n, v, t]) => (
            <div class="split">
              <p>
                <span>{n}</span>
                <b>
                  {v}% <small>/ {t}%</small>
                </b>
              </p>
              <div class="track">
                <span style={`width:${v}%`} />
                <i style={`left:${t}%`} />
              </div>
            </div>
          ))}
        </div>
      </div>
    </main>
    <span class="co" style="--x:26%;--y:16%">1</span>
    <span class="co" style="--x:64%;--y:16%">2</span>
  </div>

  <!-- 5 · Goals & investments -->
  <div data-screen aria-hidden="true" class="bk">
    <aside class="sb">
      <p class="logo">Banky<small>{u.sub}</small></p>
      {nav(5).map(({ n, on }) => <p class:list={['ni', on && 'on']}>{n}</p>)}
    </aside>
    <main class="mn">
      <h6>{u.goals}</h6>
      <div class="two">
        {u.goalRows.map(([g, p, d]) => (
          <div class="box goal">
            <p class="gname">{g}</p>
            <div class="ring">
              <svg viewBox="0 0 42 42">
                <circle cx="21" cy="21" r="15.9" fill="none" stroke="#1d2a2f" stroke-width="4" />
                <circle cx="21" cy="21" r="15.9" fill="none" stroke="#d8a75a" stroke-width="4" stroke-dasharray={`${p} ${100 - Number(p)}`} stroke-dashoffset="25" />
              </svg>
              <b>{p}%</b>
            </div>
            <p class="gd">{d}</p>
          </div>
        ))}
      </div>
      <h6>{u.invest}</h6>
      <div class="box">
        <p class="inv head">{u.invCols.map((c) => <span>{c}</span>)}</p>
        {u.invRows.map(([n, w, i]) => (
          <p class="inv">
            <span>{n}</span>
            <b class="num">{money(Number(w))}</b>
            <b class="num">{money(Number(i))}</b>
            <b class="num pos">+{money(Number(w) - Number(i))}</b>
          </p>
        ))}
      </div>
    </main>
    <span class="co" style="--x:28%;--y:14%">1</span>
    <span class="co" style="--x:28%;--y:68%">2</span>
  </div>

  <!-- 6 · Receipts -->
  <div data-screen aria-hidden="true" class="bk">
    <aside class="sb">
      <p class="logo">Banky<small>{u.sub}</small></p>
      {nav(9).map(({ n, on }) => <p class:list={['ni', on && 'on']}>{n}</p>)}
    </aside>
    <main class="mn rc">
      <div class="receipt">
        <p class="rh">{u.receipt}</p>
        {u.items.map(([n, q, p]) => (
          <p class="rl">
            <span>
              {n} x{q}
            </span>
            <span>{money(Number(p))}</span>
          </p>
        ))}
        <p class="rl tot">
          <span>{u.total}</span>
          <span>{money(itemsTotal)}</span>
        </p>
        <div class="scan" />
      </div>
      <div class="box items">
        <p class="it head">{u.itemCols.map((c) => <span>{c}</span>)}</p>
        {u.items.map(([n, q, p]) => (
          <p class="it">
            <span>{n}</span>
            <span>{q}</span>
            <b class="num">{money(Number(p))}</b>
          </p>
        ))}
        <p class="it tot">
          <span>{u.total}</span>
          <span />
          <b class="num">{money(itemsTotal)}</b>
        </p>
        <p class="match">{u.matches}</p>
      </div>
    </main>
    <span class="co" style="--x:28%;--y:14%">1</span>
    <span class="co" style="--x:62%;--y:26%">2</span>
    <span class="co" style="--x:62%;--y:40%">3</span>
  </div>

  <!-- 7 · Monthly report -->
  <div data-screen aria-hidden="true" class="bk rep">
    <div class="rpage">
      <div class="rhead">
        <b>{u.report}</b>
        <span class="gold">{u.print}</span>
      </div>
      <div class="rnums">
