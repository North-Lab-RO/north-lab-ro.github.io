---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Lang } from '../../i18n/ui';

export interface TourStep {
  image: ImageMetadata;
  alt: string;
  tab: string;
  title: string;
  /** One line per numbered callout, in the same order as `callouts`. */
  points: string[];
  /** Marker positions on the screenshot, as percentages of its width and height. */
  callouts: { x: number; y: number }[];
}
interface Props {
  lang: Lang;
  label: string;
  steps: TourStep[];
  url?: string;
  /** Extra line under the frame, e.g. the language of the real interface. */
  note?: string;
}
const { lang, label, steps, url = '', note } = Astro.props;
const uid = label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const copy = {
  en: { caption: 'Real screens with invented data.', step: 'Screen', prev: 'Previous screen', next: 'Next screen' },
  ro: { caption: 'Ecrane reale, cu date inventate.', step: 'Ecranul', prev: 'Ecranul anterior', next: 'Ecranul următor' },
}[lang];
---

<section class="tour" data-tour aria-label={label}>
  <div class="tabs" role="tablist" aria-label={label}>
    {
      steps.map((s, i) => (
        <button
          role="tab"
          id={`${uid}-tab-${i}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          aria-controls={`${uid}-panel`}
          tabindex={i === 0 ? 0 : -1}
          data-tab={i}
        >
          <span class="n">{i + 1}</span>
          {s.tab}
        </button>
      ))
    }
  </div>

  <div class="body" id={`${uid}-panel`} role="tabpanel">
    <div class="window">
      <div class="bar" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        {url && <span class="url">{url}</span>}
      </div>
      <div class="stage">
        {
          steps.map((s, i) => (
            <figure class:list={['screen', i === 0 && 'on']} data-screen>
              <div class="shot" style={`--r:${(s.image.width / s.image.height).toFixed(4)}`}>
                <Image
                  src={s.image}
                  alt={s.alt}
                  widths={[720, 1080, 1440, 2160]}
                  sizes="(min-width: 1100px) 70vw, 100vw"
                  loading={i === 0 ? 'eager' : 'lazy'}
                />
                {s.callouts.map((c, k) => (
                  <span class="co" style={`left:${c.x}%;top:${c.y}%`} aria-hidden="true">
                    {k + 1}
                  </span>
                ))}
              </div>
            </figure>
          ))
        }
        <button class="nav prev" data-step-dir="-1" aria-label={copy.prev}>‹</button>
        <button class="nav next" data-step-dir="1" aria-label={copy.next}>›</button>
      </div>
      <div class="progress" aria-hidden="true"><span data-progress></span></div>
    </div>

    <div class="explain">
      {
        steps.map((s, i) => (
          <div class:list={['step', i === 0 && 'on']} data-step-text={i}>
            <p class="label">
              {copy.step} {i + 1} / {steps.length}
            </p>
            <h3 class="h-sub">{s.title}</h3>
            <ol class="points">
              {s.points.map((p, k) => (
                <li>
                  <span class="badge">{k + 1}</span>
                  <span>{p}</span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </div>
  <p class="caption muted">
    {copy.caption}
    {note && <> {note}</>}
  </p>
</section>

<script>
  const AUTO_MS = 9000;
  document.querySelectorAll<HTMLElement>('[data-tour]').forEach((tour) => {
    const tabs = [...tour.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const screens = [...tour.querySelectorAll<HTMLElement>('[data-screen]')];
    const texts = [...tour.querySelectorAll<HTMLElement>('[data-step-text]')];
    const bar = tour.querySelector<HTMLElement>('[data-progress]')!;
    const strip = tour.querySelector<HTMLElement>('[role="tablist"]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer = 0;
    let paused = false;
    let userTook = false;
    let inView = false;

    const restart = () => {
      clearTimeout(timer);
      bar.style.transition = 'none';
      bar.style.width = '0%';
      if (userTook || paused || !inView) return;
      const ms = reduce ? AUTO_MS * 1.5 : AUTO_MS;
      requestAnimationFrame(() => {
        bar.style.transition = `width ${ms}ms linear`;
        bar.style.width = '100%';
      });
      timer = window.setTimeout(() => show(current + 1), ms);
    };

    const show = (i: number, focus = false) => {
      current = (i + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        const on = k === current;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
      });
      screens.forEach((s, k) => s.classList.toggle('on', k === current));
      texts.forEach((s, k) => s.classList.toggle('on', k === current));
      if (focus) tabs[current].focus();
      // Keep the active tab visible in the horizontally scrolling strip without moving the page.
      const t = tabs[current];
      if (t.offsetLeft < strip.scrollLeft || t.offsetLeft + t.offsetWidth > strip.scrollLeft + strip.clientWidth) {
        strip.scrollTo({ left: t.offsetLeft - 16, behavior: reduce ? 'auto' : 'smooth' });
      }
      restart();
    };

    tabs.forEach((t, k) =>
      t.addEventListener('click', () => {
        userTook = true;
        show(k);
      }),
    );
    tour.querySelectorAll<HTMLButtonElement>('[data-step-dir]').forEach((b) =>
      b.addEventListener('click', () => {
        userTook = true;
        show(current + Number(b.dataset.stepDir));
      }),
    );
    strip.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      userTook = true;
      show(current + (e.key === 'ArrowRight' ? 1 : -1), true);
    });
    const hold = (v: boolean) => () => {
      paused = v;
      restart();
    };
    tour.addEventListener('pointerenter', hold(true));
    tour.addEventListener('pointerleave', hold(false));
    tour.addEventListener('focusin', hold(true));
    tour.addEventListener('focusout', hold(false));
    new IntersectionObserver(
      ([e]) => {
        inView = e.isIntersecting;
        restart();
      },
      { threshold: 0.35 },
    ).observe(tour);

    show(0);
  });
</script>

<style>
  .tour {
    margin-block: 32px;
  }
  .tabs {
    position: relative;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    scrollbar-width: none;
    padding-bottom: 14px;
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  [role='tab'] {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 14px;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    color: var(--color-mist);
    white-space: nowrap;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }
  [role='tab']:hover {
    color: var(--color-frost);
  }
  [role='tab'][aria-selected='true'] {
    color: var(--color-night);
    background: var(--color-frost);
    border-color: var(--color-frost);
  }
  .n {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    opacity: 0.7;
  }
  .body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
  }
  .window {
    border: 1px solid var(--color-line);
    border-radius: 14px;
    overflow: hidden;
    background: #05070c;
    box-shadow: 0 40px 80px -30px rgb(0 0 0 / 0.7);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 34px;
    padding-inline: 14px;
    background: #10141d;
    border-bottom: 1px solid var(--color-line);
  }
  .dots {
    display: inline-flex;
    gap: 6px;
  }
  .dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #2a3346;
  }
  .url {
    flex: 1;
    max-width: 380px;
    padding: 3px 12px;
    border-radius: 6px;
    background: #070a10;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--color-mist);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    background: #070a10;
  }
  .screen {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    container-type: size;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.45s var(--ease-out),
      visibility 0s 0.45s;
  }
  .screen.on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.45s var(--ease-out);
  }
  /* the screenshot keeps its own aspect ratio inside the frame; markers are placed relative to it */
  .shot {
    position: relative;
    width: min(100cqw, 100cqh * var(--r));
    aspect-ratio: var(--r);
  }
  .shot :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .co {
    position: absolute;
    z-index: 2;
    display: grid;
    place-items: center;
    width: clamp(20px, 2.4vw, 30px);
    height: clamp(20px, 2.4vw, 30px);
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: var(--color-ice);
    color: #05070c;
    font: 700 clamp(11px, 1.2vw, 15px) / 1 var(--font-sans);
    box-shadow:
      0 0 0 4px rgb(139 233 255 / 0.28),
      0 6px 16px rgb(0 0 0 / 0.5);
    animation: co-pulse 2.4s ease-in-out infinite;
  }
  @keyframes co-pulse {
    50% {
      box-shadow:
        0 0 0 9px rgb(139 233 255 / 0.08),
        0 6px 16px rgb(0 0 0 / 0.5);
    }
  }
  .nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-top: -21px;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.18);
    background: rgb(5 10 22 / 0.72);
    backdrop-filter: blur(6px);
    color: var(--color-frost);
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }
  .nav:hover {
    border-color: var(--color-ice);
    background: rgb(5 10 22 / 0.9);
  }
  .prev {
    left: 10px;
  }
  .next {
    right: 10px;
  }
  .progress {
    height: 3px;
    background: #10141d;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--color-ice);
  }
  .step {
    display: none;
  }
  .step.on {
    display: block;
  }
  .step .h-sub {
    margin-top: 8px;
  }
  .points {
    display: grid;
    gap: 12px;
    margin-top: 16px;
  }
  .points li {
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-frost) 85%, var(--color-mist));
  }
  .badge {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-ice);
    color: var(--color-night);
    font-weight: 700;
    font-size: 0.8rem;
  }
  .caption {
    margin-top: 16px;
    font-size: 0.82rem;
  }
  @media (max-width: 640px) {
    .nav {
      top: auto;
      bottom: 8px;
      margin-top: 0;
      width: 38px;
      height: 38px;
    }
  }
  @media (min-width: 1100px) {
    .body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 3fr);
      align-items: start;
    }
  }
</style>
