---
import TourFrame from './TourFrame.astro';
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const C = {
  en: {
    label: 'CASES product tour',
    steps: [
      {
        tab: 'Choose a case',
        title: 'Pick a case, name the team, start the clock',
        points: [
          'A library of case files, each with its year, difficulty and playing time.',
          'The team names itself and plays together around one screen.',
          'One button starts the clock. Progress survives a refresh, and play can be paused and resumed.',
        ],
      },
      {
        tab: 'Investigation',
        title: 'The investigation desk',
        points: [
          'A large countdown and the investigation day keep the pressure on.',
          'Every part of the case in one place: briefing, evidence, people, map, paperwork, lab, notes.',
          'Every action shows what it costs in time before you commit to it.',
          'Search places on the map; evidence, people and events appear as layers.',
        ],
      },
      {
        tab: 'Suspects',
        title: 'Question people, and catch their lies',
        points: [
          'Ask questions from the file; each one takes time.',
          'Confront a statement with a finding you hold: broken lies are struck through.',
          'Ask the file anything about what you have already found, for free.',
        ],
      },
      {
        tab: 'Laboratory',
        title: 'A forensic lab that runs on the clock',
        points: [
          'Three benches: send exhibits and collect reports when they are ready.',
          'Nine kinds of test, from fingerprints to handwriting, depending on the era.',
          'Results arrive in game time, so planning the lab is part of the strategy.',
        ],
      },
      {
        tab: 'Print the kit',
        title: 'A physical table, not just a screen',
        points: [
          'Every sheet prints on A4: briefing, map, exhibits, lab reports, documents.',
          'It remembers what was printed and only offers the new sheets.',
          'The rules and the trial transcript print too.',
        ],
      },
      {
        tab: 'Report & trial',
        title: 'File the report, face the court',
        points: [
          'Name who did it, why and how, and which exhibits prove it.',
          'Put the events in order.',
          'An animated courtroom plays out the trial, exhibit by exhibit.',
          'Five possible verdicts and a score out of 100.',
        ],
      },
      {
        tab: 'Game master',
        title: 'A new case whenever you need one',
        points: [
          'Choose the difficulty, from a 60-minute routine case to a 3-hour cold case.',
          'Optionally give a theme, like “industrial arson, coastal town”.',
          'Watch the case being written and checked, stage by stage.',
          'Review every case, including its solution, before publishing it to players.',
        ],
      },
    ],
    ui: {
      dept: 'CRIMINAL INVESTIGATION DEPARTMENT',
      files: [
        ['23-0121', 'The Silent Alarm', 'Homicide', '2020', 'Standard · 90 min'],
        ['23-0144', 'The Harbour Ledger', 'Fraud', '1974', 'Complex · 120 min'],
        ['23-0158', 'Last Train North', 'Disappearance', '1931', 'Cold case · 180 min'],
      ],
      team: 'Team name',
      teamVal: 'The Table',
      start: 'Start the clock',
      pause: 'Pause the clock',
      leave: 'Leave',
      remaining: 'Time remaining',
      day: 'Day 3 / 10',
      tabs: [
        ['Briefing', ''],
        ['Evidence', '4'],
        ['People', '6'],
        ['Map', ''],
        ['Paperwork', '3'],
        ['Laboratory', '1'],
        ['Notes', ''],
        ['Print the kit', ''],
        ['The Report', ''],
      ],
      layers: ['Evidence', 'People', 'Timeline'],
      place: 'Riverside warehouse',
      search: 'Search this place',
      cost: '45 min · 30 s of your sitting',
      person: 'Samuel Carter · Business partner',
      statement: '“I was at home alone that night. I didn’t go out and nobody came by.”',
      questions: [
        ['Where were you on the night of the 14th?', '15 min'],
        ['When did you last speak to the victim?', '15 min'],
      ],
      lie: 'They changed their account when shown the doorbell footage.',
      challenge: 'Challenge with a finding',
      ask: 'Ask the file',
      askNote: 'free · only what you have found',
      benches: [
        ['Bench 1', 'Fingerprint · E-01', 'Ready', 'Collect report'],
        ['Bench 2', 'DNA · E-02', 'Due on day 5', ''],
        ['Bench 3', '', 'Free', 'Send an exhibit'],
      ],
      tests: ['DNA', 'Fingerprint', 'Blood', 'Fibre', 'Ballistics', 'Digital', 'Handwriting', 'Toxicology', 'Document'],
      sheets: ['Case cover', 'Exhibit E-01', 'Location sheet', 'Lab report'],
      printed: 'Printed',
      newSheets: 'Print 4 new sheets',
      also: 'Also printable: rules · trial transcript',
      who: 'Who did it',
      whoVal: ['Samuel Carter'],
      why: 'Why',
      whyVal: 'To hide money taken from the business',
      exhibits: 'Exhibits entered',
      exhibitVal: ['E-01', 'E-05', 'E-08'],
      order: 'Order of events',
      orderVal: ['02:10 Arrives by the side door', '02:30 The shot', '02:41 Leaves on foot'],
      court: 'Go to court',
      verdict: 'CONVICTED',
      score: 'Score 86 / 100',
      verdicts: ['Convicted', 'Charged', 'Not proven', 'Acquitted', 'No charge'],
      gen: 'Generate a case',
      diff: 'Difficulty',
      diffs: ['Routine · 60 min', 'Standard · 90 min', 'Complex · 120 min', 'Cold case · 180 min'],
      theme: 'Theme (optional)',
      themeVal: 'industrial arson, coastal town',
      go: 'Generate',
      stages: ['Premise', 'Hidden truth', 'Cast', 'Locations', 'Evidence', 'Lab results', 'Interviews', 'Documents', 'Opening state', 'Images'],
      library: 'Case library',
      rows: [
        ['The Silent Alarm', 'PUBLISHED'],
        ['The Harbour Ledger', 'READY'],
        ['Last Train North', 'GENERATING'],
      ],
    },
  },
  ro: {
    label: 'Turul produsului CASES',
    steps: [
      {
        tab: 'Alege un caz',
        title: 'Alegi cazul, numești echipa, pornești ceasul',
        points: [
          'O bibliotecă de dosare, fiecare cu anul, dificultatea și durata de joc.',
          'Echipa își alege un nume și joacă împreună în fața unui singur ecran.',
          'Un singur buton pornește ceasul. Progresul rezistă la reîncărcare, iar jocul poate fi pus pe pauză și reluat.',
        ],
      },
      {
        tab: 'Ancheta',
        title: 'Biroul de anchetă',
        points: [
          'O numărătoare inversă mare și ziua anchetei țin presiunea sus.',
          'Toate părțile cazului într-un loc: informare, probe, persoane, hartă, documente, laborator, notițe.',
          'Fiecare acțiune arată cât timp costă înainte să o faci.',
          'Percheziționezi locuri pe hartă; probele, persoanele și evenimentele apar ca straturi.',
        ],
      },
      {
        tab: 'Suspecți',
        title: 'Interoghezi oameni și le prinzi minciunile',
        points: [
          'Pui întrebări din dosar; fiecare costă timp.',
          'Confrunți o declarație cu o dovadă pe care o ai: minciunile demontate sunt tăiate.',
          'Întrebi dosarul orice despre ce ai găsit deja, gratuit.',
        ],
      },
      {
        tab: 'Laborator',
        title: 'Un laborator criminalistic care merge pe ceas',
        points: [
          'Trei posturi de lucru: trimiți probe și iei rapoartele când sunt gata.',
          'Nouă tipuri de teste, de la amprente la grafologie, în funcție de epocă.',
          'Rezultatele sosesc în timpul jocului, deci planificarea laboratorului face parte din strategie.',
        ],
      },
      {
        tab: 'Kitul tipărit',
        title: 'O masă adevărată, nu doar un ecran',
        points: [
          'Fiecare fișă se tipărește pe A4: informare, hartă, probe, rapoarte de laborator, documente.',
          'Ține minte ce s-a tipărit și oferă doar fișele noi.',
          'Se tipăresc și regulile, și stenograma procesului.',
        ],
      },
      {
        tab: 'Raport și proces',
        title: 'Depui raportul, înfrunți instanța',
        points: [
          'Numești cine a făcut-o, de ce și cum, și ce probe o dovedesc.',
          'Pui evenimentele în ordine.',
          'O sală de judecată animată derulează procesul, probă cu probă.',
          'Cinci verdicte posibile și un punctaj din 100.',
        ],
      },
      {
        tab: 'Organizator',
        title: 'Un caz nou oricând ai nevoie',
        points: [
          'Alegi dificultatea, de la un caz de rutină de 60 de minute la un caz vechi de 3 ore.',
          'Opțional, dai o temă, de exemplu „incendiu industrial, oraș de coastă”.',
          'Urmărești cum este scris și verificat cazul, etapă cu etapă.',
          'Revizuiești fiecare caz, inclusiv soluția, înainte să îl publici pentru jucători.',
        ],
      },
    ],
    ui: {
      dept: 'DEPARTAMENTUL DE INVESTIGAȚII CRIMINALE',
      files: [
        ['23-0121', 'Alarma silențioasă', 'Omucidere', '2020', 'Standard · 90 min'],
        ['23-0144', 'Registrul din port', 'Fraudă', '1974', 'Complex · 120 min'],
        ['23-0158', 'Ultimul tren spre nord', 'Dispariție', '1931', 'Caz vechi · 180 min'],
      ],
      team: 'Numele echipei',
      teamVal: 'Masa rotundă',
      start: 'Pornește ceasul',
      pause: 'Oprește ceasul',
      leave: 'Ieși',
      remaining: 'Timp rămas',
      day: 'Ziua 3 / 10',
      tabs: [
        ['Informare', ''],
        ['Probe', '4'],
        ['Persoane', '6'],
        ['Hartă', ''],
        ['Documente', '3'],
        ['Laborator', '1'],
        ['Notițe', ''],
        ['Tipărește kitul', ''],
        ['Raportul', ''],
      ],
      layers: ['Probe', 'Persoane', 'Cronologie'],
      place: 'Depozitul de lângă râu',
      search: 'Percheziționează locul',
      cost: '45 min · 30 s din sesiunea voastră',
      person: 'Samuel Carter · Asociat',
      statement: '„Am fost singur acasă în noaptea aceea. N-am ieșit și nu a venit nimeni.”',
      questions: [
        ['Unde erați în noaptea de 14?', '15 min'],
        ['Când ați vorbit ultima dată cu victima?', '15 min'],
      ],
      lie: 'Și-a schimbat declarația când i s-a arătat înregistrarea soneriei.',
      challenge: 'Confruntă cu o dovadă',
      ask: 'Întreabă dosarul',
      askNote: 'gratuit · doar ce ați găsit',
      benches: [
        ['Postul 1', 'Amprente · E-01', 'Gata', 'Ia raportul'],
        ['Postul 2', 'ADN · E-02', 'Gata în ziua 5', ''],
        ['Postul 3', '', 'Liber', 'Trimite o probă'],
      ],
      tests: ['ADN', 'Amprente', 'Sânge', 'Fibre', 'Balistică', 'Digital', 'Grafologie', 'Toxicologie', 'Document'],
      sheets: ['Coperta dosarului', 'Proba E-01', 'Fișa locului', 'Raport de laborator'],
      printed: 'Tipărit',
      newSheets: 'Tipărește 4 fișe noi',
      also: 'Se mai tipăresc: regulile · stenograma procesului',
      who: 'Cine a făcut-o',
      whoVal: ['Samuel Carter'],
      why: 'De ce',
      whyVal: 'Ca să ascundă banii luați din firmă',
      exhibits: 'Probe depuse',
      exhibitVal: ['E-01', 'E-05', 'E-08'],
      order: 'Ordinea evenimentelor',
      orderVal: ['02:10 Intră pe ușa laterală', '02:30 Împușcătura', '02:41 Pleacă pe jos'],
      court: 'Mergi în instanță',
      verdict: 'CONDAMNAT',
      score: 'Punctaj 86 / 100',
      verdicts: ['Condamnat', 'Pus sub acuzare', 'Nedovedit', 'Achitat', 'Fără acuzare'],
      gen: 'Generează un caz',
      diff: 'Dificultate',
      diffs: ['Rutină · 60 min', 'Standard · 90 min', 'Complex · 120 min', 'Caz vechi · 180 min'],
      theme: 'Temă (opțional)',
      themeVal: 'incendiu industrial, oraș de coastă',
      go: 'Generează',
      stages: ['Premisă', 'Adevăr ascuns', 'Personaje', 'Locuri', 'Probe', 'Laborator', 'Interogatorii', 'Documente', 'Start', 'Imagini'],
      library: 'Biblioteca de cazuri',
      rows: [
        ['Alarma silențioasă', 'PUBLICAT'],
        ['Registrul din port', 'GATA'],
        ['Ultimul tren spre nord', 'SE GENEREAZĂ'],
      ],
    },
  },
}[lang];
const u = C.ui;
---

<TourFrame lang={lang} label={C.label} steps={C.steps} url="cases.local">
  <!-- 1 · Choose a case -->
  <div data-screen aria-hidden="true" class="cz">
    <p class="dept">{u.dept}</p>
    <div class="files">
      {
        u.files.map(([no, title, crime, year, len], i) => (
          <div class:list={['file', i === 0 && 'sel']}>
            <span class="year" data-y={year} />
            <p class="no">No. {no}</p>
            <h4>{title}</h4>
            <p class="crime">
              {crime} · {year}
            </p>
            <p class="len">{len}</p>
          </div>
        ))
      }
    </div>
    <div class="teambar">
      <label>{u.team}</label>
      <span class="inp">{u.teamVal}</span>
      <span class="amber">{u.start} ▶</span>
    </div>
    <span class="co" style="--x:12%;--y:26%">1</span>
    <span class="co" style="--x:30%;--y:73%">2</span>
    <span class="co" style="--x:80%;--y:73%">3</span>
  </div>

  <!-- 2 · Investigation -->
  <div data-screen aria-hidden="true" class="cz">
    <div class="topbar">
      <b>No. 23-0121 · {u.files[0][1]}</b>
      <span class="ghost">⏸ {u.pause}</span>
      <span class="ghost">{u.leave}</span>
    </div>
    <div class="clock">
      <span class="lbl">{u.remaining}</span>
      <span class="big">01:12:40</span>
      <span class="day">{u.day}</span>
      <span class="pin">⚗ E-02 · 5</span>
    </div>
    <div class="ztabs">{u.tabs.map(([t, n], i) => <span class:list={[i === 3 && 'on']}>{t}{n && <em>{n}</em>}</span>)}</div>
    <div class="mapbox">
      <svg viewBox="0 0 620 300" class="zmap">
        <rect width="620" height="300" fill="#212831" />
        <path d="M0 210 Q160 180 300 220 T620 200 L620 300 L0 300 Z" fill="#1b3a45" />
        {[60, 140, 220, 300, 380, 460, 540].map((x) => <line x1={x} x2={x} y1="0" y2="300" stroke="#37414E" stroke-opacity=".5" />)}
        {[60, 120, 180].map((y) => <line x1="0" x2="620" y1={y} y2={y} stroke="#37414E" stroke-opacity=".5" />)}
        <circle cx="330" cy="170" r="10" fill="#E0A33E" />
        <circle cx="180" cy="90" r="7" fill="#4E8C7D" />
        <circle cx="470" cy="110" r="7" fill="#4E8C7D" />
        <circle cx="250" cy="240" r="7" fill="#D6453C" />
      </svg>
      <div class="mapside">
        <div class="layers">{u.layers.map((l) => <span>☑ {l}</span>)}</div>
        <h5>{u.place}</h5>
        <span class="amber">{u.search}</span>
        <p class="cost">⏱ {u.cost}</p>
      </div>
    </div>
    <span class="co" style="--x:56%;--y:21%">1</span>
    <span class="co" style="--x:6%;--y:33%">2</span>
    <span class="co" style="--x:94%;--y:62%">3</span>
    <span class="co" style="--x:80%;--y:47%">4</span>
  </div>

  <!-- 3 · Suspects -->
  <div data-screen aria-hidden="true" class="cz">
    <div class="ztabs">{u.tabs.map(([t, n], i) => <span class:list={[i === 2 && 'on']}>{t}{n && <em>{n}</em>}</span>)}</div>
    <div class="person">
      <div class="por">
        <img src="/textures/portrait-1.webp" alt="" width="200" height="200" loading="lazy" />
        <p>{u.person}</p>
      </div>
      <div class="talk">
        <div class="sheet">
          <p class="stm struck">{u.statement}</p>
          <p class="changed">✕ {u.lie}</p>
        </div>
        {u.questions.map(([q, c]) => (
          <div class="q">
            <span>{q}</span>
            <em>⏱ {c}</em>
          </div>
        ))}
        <div class="acts2">
          <span class="amber">{u.challenge}</span>
          <span class="ghost">
            {u.ask} <small>{u.askNote}</small>
          </span>
        </div>
      </div>
    </div>
    <span class="co" style="--x:94%;--y:50%">1</span>
    <span class="co" style="--x:40%;--y:30%">2</span>
    <span class="co" style="--x:46%;--y:68%">3</span>
  </div>

  <!-- 4 · Laboratory -->
  <div data-screen aria-hidden="true" class="cz">
    <div class="ztabs">{u.tabs.map(([t, n], i) => <span class:list={[i === 5 && 'on']}>{t}{n && <em>{n}</em>}</span>)}</div>
    <div class="benches">
      {
        u.benches.map(([b, test, st, act], i) => (
          <div class:list={['bench', i === 0 ? 'ready' : i === 1 ? 'busy' : 'free']}>
            <p class="lbl">{b}</p>
            <h5>{test || '—'}</h5>
            <p class="st">{st}</p>
            {act && <span class={i === 0 ? 'amber' : 'ghost'}>{act}</span>}
          </div>
        ))
      }
    </div>
    <div class="tests">{u.tests.map((t) => <span>{t}</span>)}</div>
    <div class="clock mini">
      <span class="lbl">{u.remaining}</span>
      <span class="big">01:04:12</span>
      <span class="day">{u.day}</span>
      <span class="pin">⚗ E-02 · 5</span>
    </div>
    <span class="co" style="--x:6%;--y:24%">1</span>
    <span class="co" style="--x:6%;--y:53%">2</span>
    <span class="co" style="--x:92%;--y:84%">3</span>
  </div>

  <!-- 5 · Print the kit -->
  <div data-screen aria-hidden="true" class="cz">
    <div class="sheets">
      {
        u.sheets.map((s, i) => (
          <div class="a4" style={`--r:${[-6, -2, 3, 7][i]}deg;--x:${i * 120}px`}>
            <p class="a4h">No. 23-0121</p>
            <p class="a4t">{s}</p>
            {i === 1 && <img src="/textures/evidence-knives.webp" alt="" width="140" height="140" loading="lazy" />}
            {i !== 1 && (
              <div class="lines">
                <i />
                <i />
                <i />
                <i />
                <i />
              </div>
            )}
          </div>
        ))
      }
    </div>
    <div class="printlist">
      {u.sheets.map((s, i) => (
        <p>
          <span class:list={['box', i < 2 && 'done']}>{i < 2 ? '✓' : ''}</span>
          {s}
          {i < 2 && <em>{u.printed}</em>}
        </p>
      ))}
      <span class="amber">🖨 {u.newSheets}</span>
      <p class="also">{u.also}</p>
    </div>
    <span class="co" style="--x:30%;--y:18%">1</span>
    <span class="co" style="--x:70%;--y:26%">2</span>
    <span class="co" style="--x:70%;--y:52%">3</span>
  </div>

  <!-- 6 · Report & trial -->
  <div data-screen aria-hidden="true" class="cz">
    <div class="report">
      <div class="form">
        <p class="lbl">{u.who}</p>
        <div class="chips">{u.whoVal.map((w) => <span>{w}</span>)}</div>
        <p class="lbl">{u.why}</p>
        <p class="inp">{u.whyVal}</p>
        <p class="lbl">{u.exhibits}</p>
        <div class="chips">{u.exhibitVal.map((w) => <span>{w}</span>)}</div>
        <p class="lbl">{u.order}</p>
        {u.orderVal.map((o) => (
          <p class="ord">
            <span>{o}</span>
            <em>↑ ↓</em>
          </p>
        ))}
        <span class="amber">{u.court} →</span>
      </div>
      <div class="court">
        <svg viewBox="0 0 400 260">
          <rect width="400" height="260" fill="#212831" />
          <rect x="120" y="30" width="160" height="50" fill="#37414E" />
          <circle cx="200" cy="22" r="14" fill="#8A97A6" />
          <rect x="40" y="140" width="80" height="60" fill="#2b333e" />
          <rect x="280" y="140" width="80" height="60" fill="#2b333e" />
          <rect x="165" y="170" width="70" height="60" fill="#37414E" stroke="#E0A33E" />
          <circle cx="200" cy="160" r="12" fill="#8A97A6" />
        </svg>
        <div class="verdict">
          <b>{u.verdict}</b>
          <span>{u.score}</span>
        </div>
        <div class="vlist">{u.verdicts.map((v, i) => <span class:list={[i === 0 && 'on']}>{v}</span>)}</div>
      </div>
    </div>
    <span class="co" style="--x:6%;--y:12%">1</span>
    <span class="co" style="--x:6%;--y:45%">2</span>
    <span class="co" style="--x:94%;--y:14%">3</span>
    <span class="co" style="--x:94%;--y:44%">4</span>
  </div>

  <!-- 7 · Game master -->
  <div data-screen aria-hidden="true" class="cz admin">
    <div class="gen">
      <h4>{u.gen}</h4>
      <p class="lbl">{u.diff}</p>
      <div class="diffs">{u.diffs.map((d, i) => <span class:list={[i === 1 && 'on']}>{d}</span>)}</div>
      <p class="lbl">{u.theme}</p>
      <p class="inp">{u.themeVal}</p>
      <span class="amber">{u.go}</span>
      <ol class="stg">
        {u.stages.map((s, i) => (
          <li class:list={[i < 6 ? 'ok' : i === 6 ? 'now' : '']}>
            {i < 6 ? '✓' : i === 6 ? '●' : '○'} {s}
          </li>
        ))}
      </ol>
    </div>
    <div class="lib">
      <h4>{u.library}</h4>
      {u.rows.map(([t, s], i) => (
        <p class="libr">
          <span>{t}</span>
          <em class={['st-pub', 'st-ready', 'st-gen'][i]}>{s}</em>
        </p>
      ))}
    </div>
    <span class="co" style="--x:6%;--y:20%">1</span>
    <span class="co" style="--x:6%;--y:38%">2</span>
    <span class="co" style="--x:6%;--y:50%">3</span>
    <span class="co" style="--x:58%;--y:16%">4</span>
  </div>
</TourFrame>

<style>
  .cz {
    background: #171b21;
    color: #e9e3d5;
    font-family: var(--font-sans);
    font-size: 13px;
    padding: 22px 28px;
    overflow: hidden;
  }
  .lbl,
  .dept {
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #8a97a6;
    margin: 12px 0 6px;
  }
