---

<TourFrame lang={lang} label={C.label} steps={C.steps} url="counselor.local">
  <!-- 1 · Today -->
  <div data-screen aria-hidden="true" class="cs">
    <header class="hd">
      <span class="logo">▶</span>
      <span class="brand">COUNSELOR<small>{u.tagline}</small></span>
      <span class="ai"><i></i>{u.working}</span>
      <span class="navr">{u.nav.map((n) => <span>{n}</span>)}</span>
    </header>
    <nav class="tb">{u.tabs.map((t, i) => <span class:list={[i === 0 && 'on']}>{t}</span>)}</nav>
    <div class="ticker"><b>● {u.live}</b><span class="crawl">{u.ticker}</span></div>
    <div class="row">
      <span class="hello">{u.hello}</span>
      <span class="clocks">{u.clocks.map((c) => <span>{c}</span>)}</span>
      <span class="spaces">{u.spaces.map((s, i) => <span class:list={[i === 0 && 'on']}>{s}</span>)}</span>
      <span class="days">{u.days.map((d, i) => <span class:list={[i === 0 && 'on']}>{d}</span>)}</span>
    </div>
    <div class="grid">
      <div class="globe">
        <svg viewBox="0 0 300 300">
          <circle cx="150" cy="150" r="128" fill="#07140f" stroke="#0f5040" />
          {[40, 80, 120].map((r) => <ellipse cx="150" cy="150" rx={r} ry="128" fill="none" stroke="#0f5040" stroke-opacity=".5" />)}
          {[-80, -40, 0, 40, 80].map((y) => <ellipse cx="150" cy={150 + y} rx={Math.sqrt(128 * 128 - y * y)} ry="6" fill="none" stroke="#0f5040" stroke-opacity=".4" />)}
          {markers.map(([x, y, r, c]) => <circle cx={x * 300} cy={y * 300} r={r} fill={c} fill-opacity=".85" class="mk" />)}
        </svg>
      </div>
      <div class="panels">
        <section class="pn">
          <h5>{u.alerts} <em>2</em></h5>
          {u.alertItems.map(([t, w], i) => (
            <div class:list={['alert', i === 0 ? 'crit' : 'high']}>
              <b>{t}</b>
              <span>{w}</span>
            </div>
          ))}
        </section>
        <section class="pn">
          <h5>{u.headlines} <em>4</em></h5>
          {u.headItems.map(([t, n]) => (
            <div class="line">
              <span>{t}</span>
              <i>{n}</i>
            </div>
          ))}
        </section>
        <section class="pn">
          <h5>{u.rising} <em>3</em></h5>
          {u.risingItems.map(([t, n]) => (
            <div class="line">
              <span>{t}</span>
              <i class="up">↑ {n}</i>
            </div>
          ))}
        </section>
        <section class="pn">
          <h5>{u.bias}</h5>
          <div class="spec">{dots.map((d) => <i style={`left:${d * 100}%`} />)}</div>
          <div class="scale">{u.biasScale.map((s) => <span>{s}</span>)}</div>
        </section>
      </div>
    </div>
    <span class="co" style="--x:52%;--y:18.5%">1</span>
    <span class="co" style="--x:44%;--y:36%">2</span>
    <span class="co" style="--x:96%;--y:60%">3</span>
    <span class="co" style="--x:96%;--y:36%">4</span>
    <span class="co" style="--x:18%;--y:44%">5</span>
  </div>

  <!-- 2 · Story -->
  <div data-screen aria-hidden="true" class="cs">
    <header class="hd">
      <span class="logo">▶</span>
      <span class="brand">COUNSELOR<small>{u.tagline}</small></span>
      <span class="ai"><i></i>{u.working}</span>
      <span class="navr">{u.nav.map((n) => <span>{n}</span>)}</span>
    </header>
    <div class="story">
      <div class="main">
        <p class="back">{u.back}</p>
        <h3 class="st">{u.storyTitle}</h3>
        <p class="meta">{u.storyMeta}</p>
        <div class="acts">
          <span class="seg">{u.lengths.map((l, i) => <span class:list={[i === 1 && 'on']}>{l}</span>)}</span>
          <span class="btn">{u.save}</span>
          <span class="btn">{u.later}</span>
        </div>
        <p class="sum">{u.summary}</p>
        <div class="kv">
          <div>
            <h6>{u.known}</h6>
            {u.knownItems.map((k) => <p>— {k}</p>)}
          </div>
          <div>
            <h6>{u.unknown}</h6>
            {u.unknownItems.map((k) => <p>— {k}</p>)}
          </div>
        </div>
        <div class="evo">
          <h6>{u.evolution}</h6>
          <div class="evl">
            {u.evo.map(([t, d]) => (
              <span>
                <b>{t}</b>
                {d}
              </span>
            ))}
          </div>
        </div>
      </div>
      <aside class="side">
        <h6>{u.spectrum}</h6>
        <div class="bands">{['#3e6fb0', '#6e9ad1', '#98a2ae', '#d09a63', '#b4553a'].map((c, i) => <span style={`background:${c};height:${[20, 34, 60, 30, 14][i]}px`} />)}</div>
        <div class="scale">{u.biasScale.map((s) => <span>{s}</span>)}</div>
        <h6>{u.consensus} · 78%</h6>
        <div class="meter"><span style="width:78%" /></div>
        <h6>{u.confidence} · {u.high}</h6>
        <div class="meter"><span style="width:86%" /></div>
      </aside>
    </div>
    <span class="co" style="--x:14%;--y:30%">1</span>
    <span class="co" style="--x:72%;--y:18%">2</span>
    <span class="co" style="--x:72%;--y:47%">3</span>
    <span class="co" style="--x:6%;--y:50%">4</span>
    <span class="co" style="--x:6%;--y:66%">5</span>
  </div>

  <!-- 3 · Global monitor -->
  <div data-screen aria-hidden="true" class="cs">
    <header class="hd">
      <span class="logo">▶</span>
      <span class="brand">COUNSELOR<small>{u.tagline}</small></span>
      <span class="ai"><i></i>{u.working}</span>
      <span class="navr">{u.nav.map((n) => <span>{n}</span>)}</span>
    </header>
    <nav class="tb">{u.tabs.map((t, i) => <span class:list={[i === 2 && 'on']}>{t}</span>)}</nav>
    <div class="mon">
      <div class="mapwrap">
        <div class="mapbar">
          <b>{u.monitor}</b>
          <span class="seg">{u.windows.map((w, i) => <span class:list={[i === 0 && 'on']}>{w}</span>)}</span>
          <span class="seg">{u.toggles.map((w) => <span class="on">{w}</span>)}</span>
        </div>
        <svg viewBox="0 0 640 380" class="map">
          <rect width="640" height="380" fill="#020a08" />
          {Array.from({ length: 9 }, (_, i) => <line x1="0" x2="640" y1={i * 45 + 10} y2={i * 45 + 10} stroke="#0a2018" />)}
          {Array.from({ length: 15 }, (_, i) => <line y1="0" y2="380" x1={i * 45 + 5} x2={i * 45 + 5} stroke="#0a2018" />)}
          <path d="M60 120 Q120 70 190 95 T300 110 L320 170 Q260 210 200 200 T90 190 Z" fill="#0a2018" stroke="#0f5040" />
          <path d="M320 80 Q380 60 450 70 T560 100 L570 160 Q500 200 430 180 T330 150 Z" fill="#0a2018" stroke="#0f5040" />
          <path d="M340 190 Q380 190 400 230 T380 320 Q350 330 335 280 Z" fill="#0a2018" stroke="#0f5040" />
          <path d="M150 220 Q190 230 200 280 T170 350 Q140 330 140 280 Z" fill="#0a2018" stroke="#0f5040" />
          <path d="M500 250 Q560 250 580 290 T540 330 Q500 320 495 290 Z" fill="#0a2018" stroke="#0f5040" />
