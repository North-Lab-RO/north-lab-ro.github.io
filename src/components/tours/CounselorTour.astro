const u = C.ui;
const dots = [0.12, 0.26, 0.4, 0.47, 0.52, 0.58, 0.66, 0.78, 0.9];
// globe markers: x, y, radius, colour (importance band)
const markers: [number, number, number, string][] = [
  [0.58, 0.36, 9, '#ff4444'],
  [0.64, 0.3, 6, '#ff8800'],
  [0.5, 0.33, 5, '#ffaa00'],
  [0.46, 0.44, 4, '#ffaa00'],
  [0.7, 0.5, 5, '#ff8800'],
