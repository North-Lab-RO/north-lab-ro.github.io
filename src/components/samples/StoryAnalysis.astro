---
// Illustrative story: layout and fields mirror the app's story view; the event is invented.
import type { Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const sources = [0.18, 0.31, 0.42, 0.47, 0.5, 0.55, 0.61, 0.7, 0.84];
const copy = {
  en: {
    top: 'Story · 9 sources · 6 Romanian, 3 international',
    importance: 'Importance 44 · critical',
    title: 'Heat warning extended across southern Romania',
    summary:
      'The heat warning has been extended to Sunday for 14 counties. Sources agree on temperatures and duration, but differ on measures for schools.',
    bias: 'Bias spectrum',
    biasAria: 'Nine sources spread from left to right, clustered around the centre',
    scale: ['Left', 'Centre', 'Right'],
    consensus: 'Consensus',
    agreement: 'high agreement',
    known: 'What we know',
    knownItems: ['The warning covers 14 counties', 'Valid until Sunday, 22:00'],
    unclear: 'Still unclear',
    unclearItems: ['Whether schools will close', 'Impact on the power grid'],
    checks: 'Fact-check · verdicts computed from other outlets',
    items: [
      { claim: 'Temperatures will reach 39 °C in the south', verdict: 'confirmed', note: '3 outlets corroborate', tone: 'ok' },
      { claim: 'Water restrictions start in two counties', verdict: 'single source', note: 'no independent confirmation yet', tone: 'single' },
      { claim: 'Schools will close on Friday', verdict: 'contested', note: '1 outlet reports the opposite', tone: 'bad' },
    ],
    caption:
      "Illustrative sample, translated for this page. The app writes its analyses in Romanian; the fields and layout match its story view, and the event is invented.",
  },
  ro: {
    top: 'Poveste · 9 surse · 6 românești, 3 internaționale',
    importance: 'Importanță 44 · critică',
    title: 'Cod galben de caniculă prelungit în sudul țării',
    summary:
      'Avertizarea de caniculă a fost prelungită până duminică pentru 14 județe. Sursele sunt de acord asupra temperaturilor și duratei, dar diferă privind măsurile pentru școli.',
    bias: 'Spectrul surselor',
    biasAria: 'Nouă surse răspândite de la stânga la dreapta, grupate spre centru',
    scale: ['Stânga', 'Centru', 'Dreapta'],
    consensus: 'Consens',
    agreement: 'acord ridicat',
    known: 'Ce știm',
    knownItems: ['Avertizarea acoperă 14 județe', 'Valabilă până duminică, ora 22:00'],
    unclear: 'Încă neclar',
    unclearItems: ['Dacă școlile se vor închide', 'Impactul asupra rețelei electrice'],
    checks: 'Verificare · verdicte calculate din alte publicații',
    items: [
      { claim: 'Temperaturile vor ajunge la 39 °C în sud', verdict: 'confirmat', note: '3 publicații confirmă', tone: 'ok' },
      { claim: 'Restricțiile de apă încep în două județe', verdict: 'o singură sursă', note: 'nicio confirmare independentă încă', tone: 'single' },
      { claim: 'Școlile se închid vineri', verdict: 'contestat', note: 'o publicație raportează contrariul', tone: 'bad' },
    ],
    caption: 'Exemplu ilustrativ. Câmpurile și aspectul corespund paginii de poveste din aplicație; evenimentul este inventat.',
  },
}[lang];
---

<figure class="story" data-reveal>
  <div class="frame">
    <header class="top">
      <span class="label">{copy.top}</span>
      <span class="chip importance">{copy.importance}</span>
    </header>
    <h3 class="title">{copy.title}</h3>

    <div class="summary">
      <p>{copy.summary}</p>
    </div>

    <div class="meters">
      <div class="meter">
        <p class="label">{copy.bias}</p>
        <div class="spectrum" role="img" aria-label={copy.biasAria}>
          {sources.map((s) => <span class="dot" style={`left:${s * 100}%`} />)}
        </div>
        <div class="scale label">{copy.scale.map((x) => <span>{x}</span>)}</div>
      </div>
      <div class="meter">
        <p class="label">{copy.consensus}</p>
        <div class="bar"><span style="width:78%"></span></div>
        <p class="val"><strong>78%</strong> <span class="muted">{copy.agreement}</span></p>
      </div>
    </div>

    <div class="kv">
      <div>
        <p class="label">{copy.known}</p>
        <ul>{copy.knownItems.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div>
        <p class="label">{copy.unclear}</p>
        <ul>{copy.unclearItems.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>

    <div class="checks">
      <p class="label">{copy.checks}</p>
      <ul>
        {
          copy.items.map((c) => (
            <li>
              <span class="claim">{c.claim}</span>
              <span class={`verdict ${c.tone}`}>{c.verdict}</span>
              <span class="muted en-v">{c.note}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <figcaption class="muted">{copy.caption}</figcaption>
</figure>

<style>
  .story {
    margin-block: 40px;
  }
  .frame {
    display: grid;
    gap: 22px;
    padding: clamp(20px, 3vw, 32px);
    border: 1px solid var(--color-line);
    border-radius: 20px;
    background: var(--color-deep);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 10px;
  }
  .importance {
    color: var(--color-ice);
  }
  .title {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 2.6vw, 1.8rem);
    letter-spacing: -0.02em;
    line-height: 1.15;
  }
  .en {
    margin-top: -14px;
    font-size: 0.9rem;
  }
  .summary {
    display: grid;
    gap: 6px;
    padding-left: 16px;
    border-left: 2px solid var(--color-ice);
  }
  .en-t {
    font-size: 0.88rem;
  }
  .meters {
    display: grid;
    gap: 22px;
  }
  .meter .label {
    margin-bottom: 10px;
  }
  .spectrum {
    position: relative;
    height: 10px;
    border-radius: 999px;
    background: linear-gradient(90deg, #6f86ff, #3a4a6e 50%, #ff8a6f);
  }
  .dot {
    position: absolute;
    top: 50%;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: var(--color-frost);
    border: 2px solid var(--color-deep);
  }
  .scale {
    display: flex;
    justify-content: space-between;
    margin-top: 8px;
    font-size: 0.62rem;
  }
  .bar {
    height: 10px;
    border-radius: 999px;
    background: var(--color-line);
    overflow: hidden;
  }
  .bar span {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--color-ice), var(--color-aurora));
  }
  .val {
    margin-top: 8px;
    font-size: 0.9rem;
  }
  .kv {
    display: grid;
    gap: 18px;
  }
  .kv ul {
    margin-top: 8px;
    display: grid;
    gap: 4px;
  }
  .kv li::before {
    content: '— ';
    color: var(--color-mist);
  }
  .checks ul {
    display: grid;
    margin-top: 10px;
  }
  .checks li {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px 12px;
    align-items: center;
    padding-block: 12px;
    border-top: 1px solid var(--color-line);
  }
  .claim {
    font-size: 0.95rem;
  }
  .verdict {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.3em 0.7em;
    border-radius: 6px;
    border: 1px solid currentColor;
    white-space: nowrap;
  }
  .verdict.ok {
    color: var(--color-aurora);
  }
  .verdict.single {
    color: var(--color-ice);
  }
  .verdict.bad {
    color: var(--color-ember);
  }
  .en-v {
    grid-column: 1 / -1;
    font-size: 0.78rem;
  }
  figcaption {
    margin-top: 12px;
    font-size: 0.85rem;
  }
  @media (min-width: 720px) {
    .meters,
    .kv {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }
</style>
