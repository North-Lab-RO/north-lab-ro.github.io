---
import { site } from '../config';
import Wordmark from './Wordmark.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<footer class="footer">
  <div class="wrap inner">
    <div class="brand">
      <Wordmark size={22} />
      <p class="muted">{t(lang).footer.tagline}</p>
    </div>
    <div class="meta">
      {
        (site.email || site.linkedin) && (
          <p class="label contact-label">{t(lang).footer.contact}</p>
        )
      }
      {
        site.email && (
          <a href={`mailto:${site.email}`} class="gh">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3zM3 7l9 7 9-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" /></svg>
            {site.email}
          </a>
        )
      }
      {
        site.linkedin && (
          <a href={site.linkedin} class="gh" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.75h4v11H3zM9.5 9.75h3.8v1.5h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1v5.46h-4v-4.84c0-1.16-.02-2.64-1.61-2.64-1.61 0-1.86 1.26-1.86 2.56v4.92h-4z" /></svg>
            LinkedIn
          </a>
        )
      }
      <a href={site.github} class="gh" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.56-.29-5.25-1.28-5.25-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.69 5.38-5.26 5.67.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
        github.com/North-Lab-RO
      </a>
      <p class="label">© {site.year} North-Lab-RO</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    padding-block: 48px;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .brand p {
    margin-top: 12px;
    font-size: 0.95rem;
  }
  .meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-frost);
  }
  .gh:hover {
    color: var(--color-ice);
  }
  @media (min-width: 768px) {
    .inner {
      flex-direction: row;
      justify-content: space-between;
      align-items: flex-end;
    }
    .meta {
      align-items: flex-end;
    }
  }
</style>
