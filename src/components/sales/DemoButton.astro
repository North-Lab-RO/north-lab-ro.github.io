---
import { site } from '../../config';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  /** Product the request is about; goes into the email subject. */
  product?: string;
  variant?: 'primary' | 'ghost';
}
const { lang, product, variant = 'primary' } = Astro.props;
const s = t(lang).sales;
const subject = product ? `${s.demoSubject}: ${product}` : s.demoSubject;
const mail = site.email
  ? `mailto:${site.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(s.demoBody)}`
  : '';
// Both configured: the button opens a choice of email or LinkedIn. Only one: the button goes straight there.
// Neither (src/config.ts): no button at all.
const single = mail || site.linkedin;
const cls = ['btn', variant === 'primary' ? 'btn-primary' : 'btn-ghost'];
---

{
  mail && site.linkedin ? (
    <details class="demo" data-demo>
      <summary class:list={cls}>
        {s.demo} <span class="caret" aria-hidden="true">↓</span>
      </summary>
      <div class="menu">
        <p class="label">{s.demoVia}</p>
        <a href={mail} class="way">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></svg>
          <span>
            <strong>{s.demoEmail}</strong>
            <small>{site.email}</small>
          </span>
        </a>
        <a href={site.linkedin} class="way" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3" /><path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 0 1 4 0v4M12 10v7" /></svg>
          <span>
            <strong>{s.demoLinkedin}</strong>
            <small>{s.demoLinkedinNote}</small>
          </span>
          <span class="ext" aria-hidden="true">↗</span>
        </a>
      </div>
    </details>
  ) : (
    single && (
      <a href={single} class:list={cls} rel={mail ? undefined : 'noopener'}>
        {s.demo} <span aria-hidden="true">→</span>
      </a>
    )
  )
}

<script>
  // One menu open at a time; a click elsewhere or Escape closes it.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('[data-demo]')];
  const closeAll = (except?: Element) => menus.forEach((d) => d !== except && (d.open = false));
  menus.forEach((d) =>
    d.addEventListener('toggle', () => {
      if (!d.open) return;
      closeAll(d);
      // open towards the left when the button sits near the right edge of the screen
      const menu = d.querySelector<HTMLElement>('.menu')!;
      d.classList.remove('end');
      if (menu.getBoundingClientRect().right > document.documentElement.clientWidth - 16) d.classList.add('end');
    }),
  );
  document.addEventListener('click', (e) => {
    const inside = (e.target as Element).closest?.('[data-demo]');
    closeAll(inside ?? undefined);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = menus.find((d) => d.open);
    if (!open) return;
    open.open = false;
    open.querySelector('summary')?.focus();
  });
</script>

<style>
  .demo {
    position: relative;
    display: inline-block;
  }
  .demo summary {
    list-style: none;
    cursor: pointer;
    user-select: none;
  }
  .demo summary::-webkit-details-marker {
    display: none;
  }
  .caret {
    display: inline-block;
    transition: transform 0.3s var(--ease-out);
  }
  .demo[open] .caret {
    transform: rotate(180deg);
  }
  .menu {
    position: absolute;
    z-index: 30;
    top: calc(100% + 10px);
    left: 0;
    width: min(320px, calc(100vw - 32px));
    padding: 14px;
    border: 1px solid var(--color-line);
    border-radius: 18px;
    background: color-mix(in srgb, var(--color-deep) 94%, transparent);
    backdrop-filter: blur(14px);
    box-shadow: 0 24px 60px -20px rgb(0 0 0 / 0.7);
    animation: drop 0.28s var(--ease-out);
  }
  .menu .label {
    margin: 2px 6px 10px;
  }
  .way {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border-radius: 12px;
    color: var(--color-frost);
    transition: background-color 0.2s;
  }
  .way:hover,
  .way:focus-visible {
    background: color-mix(in srgb, var(--color-ice) 10%, transparent);
  }
  .way svg {
    flex: none;
    width: 22px;
    height: 22px;
    fill: none;
    stroke: var(--color-ice);
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .way span {
    display: grid;
    min-width: 0;
  }
  .way strong {
    font-weight: 600;
    font-size: 0.95rem;
  }
  .way small {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.78rem;
    color: var(--color-mist);
  }
  .way .ext {
    margin-left: auto;
    color: var(--color-mist);
  }
  .demo.end .menu {
    left: auto;
    right: 0;
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }
</style>
