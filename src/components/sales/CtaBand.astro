---
import DemoButton from './DemoButton.astro';
import { site } from '../../config';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  product?: string;
}
const { lang, product } = Astro.props;
const s = t(lang).sales;
const hasContact = Boolean(site.email || site.linkedin);
---

{
  hasContact && (
    <section class="band" aria-labelledby="cta-title">
      <div class="wrap inner" data-reveal>
        <div>
          <h2 id="cta-title" class="h-section sm">{s.ctaTitle}</h2>
          <p class="lede">{s.ctaBody}</p>
        </div>
        <div class="actions">
          <DemoButton lang={lang} product={product} />
        </div>
      </div>
    </section>
  )
}

<style>
  .band {
    padding-block: clamp(56px, 8vw, 96px);
  }
  .inner {
    display: grid;
    gap: 28px;
    align-items: center;
    padding-block: clamp(32px, 5vw, 56px);
    border-top: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    background: radial-gradient(60% 120% at 0% 50%, color-mix(in srgb, var(--color-ice) 8%, transparent), transparent 70%);
  }
  .sm {
    font-size: clamp(1.8rem, 3.6vw, 2.8rem);
  }
  .lede {
    margin-top: 14px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  @media (min-width: 900px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }
</style>
