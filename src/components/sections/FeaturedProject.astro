---
import Scene from '../3d/Scene.astro';
import ProjectVisual from '../project/ProjectVisual.astro';
import NewsTicker from '../project/NewsTicker.astro';
import { accentVar, type Project } from '../../lib';
import { t, projectHref, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  project: Project;
  /** Put the scene on the right on wide screens, so featured products alternate. */
  flip?: boolean;
  /** Only the flagship product carries the "Flagship product" badge. */
  flagship?: boolean;
}
const { lang, project, flip = false, flagship = false } = Astro.props;
const d = project.data;
const p = t(lang).projects;
const href = projectHref(lang, project.slug);
---

<article class:list={['featured', flip && 'flip']} style={`--accent:${accentVar[d.accent]}`} data-reveal>
  <a href={href} class="cover-link" aria-label={`${d.title}: ${p.readMore}`}></a>
  <div class="stage">
    {d.scene !== 'none' && <Scene name={d.scene} class="scene-desk" label={d.title} />}
    {project.slug === 'counselor' && <NewsTicker lang={lang} />}
    <div class="art-mob">
      <ProjectVisual scene={d.scene} cover={d.cover} coverAlt={d.coverAlt} logo={d.logo} gallery={d.gallery} lang={lang} />
    </div>
  </div>
  <div class="text">
    <p class="label badge"><span class="swatch" aria-hidden="true"></span>{flagship ? `${p.featured} · ${d.category}` : d.category}</p>
    <h3 class="title">{d.title}</h3>
    <p class="promise">{d.promise ?? d.tagline}</p>
    {d.promise && <p class="tagline">{d.tagline}</p>}
    {
      d.audienceShort.length > 0 && (
        <p class="for">
          <span class="label">{p.forLabel}</span> {d.audienceShort.join(' · ')}
        </p>
      )
    }
    <dl class="metrics">
      {
        d.metrics.slice(0, 4).map((m) => (
          <div>
            <dt class="value">{m.value}</dt>
            <dd class="muted">{m.label}</dd>
          </div>
        ))
      }
    </dl>
    <span class="more">{p.readMore} <span aria-hidden="true">→</span></span>
  </div>
</article>

<style>
  .featured {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--color-line);
    border-radius: 24px;
    overflow: hidden;
    background:
      radial-gradient(70% 90% at 25% 50%, color-mix(in srgb, var(--accent) 9%, transparent), transparent 70%),
      var(--color-deep);
    transition: border-color 0.5s var(--ease-out);
  }
  .featured:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--color-line));
  }
  .cover-link {
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: 24px;
  }
  .stage {
    position: relative;
  }
  /* the live scene shows on every screen size; the SVG art is only the fallback without WebGL */
  .stage :global(.scene-desk) {
    display: block;
    height: 100%;
    min-height: 380px;
  }
  .art-mob {
    display: none;
  }
  .stage:has(:global(.no-webgl)) :global(.scene-desk) {
    display: none;
  }
  .stage:has(:global(.no-webgl)) .art-mob {
    display: block;
  }
  .art-mob :global(.visual) {
    border: 0;
    border-radius: 0;
  }
  .text {
    padding: clamp(24px, 4vw, 48px);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .badge {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .swatch {
    width: 18px;
    height: 2px;
    background: var(--accent);
  }
  .title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.1rem, 3.6vw, 3.6rem);
    letter-spacing: -0.035em;
    line-height: 1;
    overflow-wrap: anywhere;
  }
  .promise {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .for {
    margin-top: 14px;
    font-size: 0.88rem;
    color: var(--color-mist);
  }
  .for .label {
    color: var(--accent);
    margin-right: 4px;
  }
  .tagline {
    margin-top: 12px;
    font-size: 1.12rem;
    max-width: 46ch;
    color: color-mix(in srgb, var(--color-frost) 85%, var(--color-mist));
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px 16px;
    margin-top: 30px;
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
  }
  .value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.4rem, 2.6vw, 2rem);
    letter-spacing: -0.02em;
    color: var(--accent);
  }
  .metrics dd {
    margin-top: 6px;
    font-size: 0.82rem;
    line-height: 1.35;
  }
  .more {
    display: inline-flex;
    gap: 8px;
    margin-top: 30px;
    font-weight: 600;
    color: var(--accent);
  }
  .more span {
    transition: transform 0.35s var(--ease-out);
  }
  .featured:hover .more span {
    transform: translateX(5px);
  }
  @media (min-width: 1000px) {
    .featured {
      grid-template-columns: minmax(0, 7fr) minmax(0, 6fr);
    }
    .featured.flip {
      grid-template-columns: minmax(0, 6fr) minmax(0, 7fr);
    }
    .flip .stage {
      order: 2;
    }
    .stage :global(.scene-desk) {
      min-height: 460px;
    }
  }
</style>
