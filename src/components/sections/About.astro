---
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const a = t(lang).about;
const icons = [
  'M12 3l7 3v5c0 4.6-3 8.4-7 10-4-1.6-7-5.4-7-10V6l7-3z',
  'M4 12h16M12 4v16M6.3 6.3l11.4 11.4M17.7 6.3L6.3 17.7',
  'M5 12l4 4L19 6',
];
const principles = a.principles.map((p, i) => ({ ...p, icon: icons[i] }));
---

<section id="about" class="section about" aria-labelledby="about-title">
  <div class="wrap grid">
    <div class="intro">
      <p class="label" data-reveal>{a.label}</p>
      <h2 id="about-title" class="h-section" data-reveal style="--delay:.06s">{a.title}</h2>
    </div>
    <div class="body">
      <p class="lede" data-reveal style="--delay:.1s">{a.lede}</p>
      <ul class="principles">
        {
          principles.map((p, i) => (
            <li class="principle" data-reveal style={`--delay:${0.12 + i * 0.08}s`}>
              <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
                <path d={p.icon} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <div>
                <h3 class="h-sub">{p.title}</h3>
                <p class="muted">{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 40px;
  }
  .intro .label {
    margin-bottom: 20px;
  }
  .principles {
    margin-top: 48px;
    display: grid;
    border-top: 1px solid var(--color-line);
  }
  .principle {
    display: grid;
    grid-template-columns: 22px 1fr;
    gap: 20px;
    padding-block: 26px;
    border-bottom: 1px solid var(--color-line);
  }
  .principle svg {
    color: var(--color-ice);
    margin-top: 3px;
  }
  .principle p {
    margin-top: 8px;
    max-width: 52ch;
  }
  @media (min-width: 960px) {
    .grid {
      grid-template-columns: 5fr 7fr;
      gap: 80px;
    }
    .intro {
      position: sticky;
      top: 120px;
      align-self: start;
    }
  }
</style>
