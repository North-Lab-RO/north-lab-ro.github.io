---
import { getProjects, accentVar } from '../../lib';
import ProjectVisual from '../project/ProjectVisual.astro';
import FeaturedProject from './FeaturedProject.astro';
import { showComingSoon } from '../../config';
import { t, projectHref, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = t(lang).projects;
const [featured, ...rest] = await getProjects(lang);
---

<section id="projects" class="section projects" aria-labelledby="projects-title">
  <div class="wrap">
    <header class="head">
      <p class="label" data-reveal>{p.label}</p>
      <h2 id="projects-title" class="h-section" data-reveal style="--delay:.06s">{p.title}</h2>
      <p class="lede" data-reveal style="--delay:.1s">{p.lede}</p>
    </header>

    {featured && <FeaturedProject lang={lang} project={featured} />}

    <ul class="grid">
      {
        rest.map((pr, i) => (
          <li class="card" style={`--accent:${accentVar[pr.data.accent]};--delay:${i * 0.08}s`} data-reveal>
            <a href={projectHref(lang, pr.slug)} class="link" aria-label={`${pr.data.title}: ${p.readMore}`} />
            <div class="visual-wrap" data-tilt>
              <ProjectVisual
                scene={pr.data.scene}
                cover={pr.data.cover}
                coverAlt={pr.data.coverAlt}
                logo={pr.data.logo}
                gallery={pr.data.gallery}
                lang={lang}
              />
            </div>
            <p class="label cat">
              <span class="swatch" aria-hidden="true" />
              {pr.data.category}
            </p>
            <h3 class="title">{pr.data.title}</h3>
            <p class="tagline">{pr.data.promise ?? pr.data.tagline}</p>
            {pr.data.audienceShort.length > 0 && (
              <p class="for">
                <span class="label">{p.forLabel}</span> {pr.data.audienceShort.join(' · ')}
              </p>
            )}
            <dl class="metrics">
              {pr.data.metrics.slice(0, 3).map((m) => (
                <div>
                  <dt class="value">{m.value}</dt>
                  <dd class="muted">{m.label}</dd>
                </div>
              ))}
            </dl>
            <span class="more">
              {p.readMore} <span aria-hidden="true">→</span>
            </span>
          </li>
        ))
      }
      {
        showComingSoon && (
          <li class="card soon panel">
            <p class="label">{p.next}</p>
            <p class="h-sub">{p.soon}</p>
          </li>
        )
      }
    </ul>
  </div>
</section>

<script>
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fine && !reduce) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
      const card = el.closest<HTMLElement>('.card')!;
      card.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        const x = (e.clientX - r.left) / r.width - 0.5;
        const y = (e.clientY - r.top) / r.height - 0.5;
        el.style.transform = `perspective(900px) rotateY(${x * 10}deg) rotateX(${-y * 10}deg)`;
      });
      card.addEventListener('pointerleave', () => (el.style.transform = ''));
    });
  }
</script>

<style>
  .head {
    max-width: 820px;
    margin-bottom: clamp(40px, 6vw, 72px);
  }
  .head .label {
    margin-bottom: 20px;
  }
  .head .lede {
    margin-top: 22px;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(48px, 6vw, 32px);
    margin-top: clamp(48px, 6vw, 72px);
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
  }
  .link {
    position: absolute;
    inset: -10px;
    z-index: 3;
    border-radius: 22px;
  }
  .visual-wrap {
    transition: transform 0.6s var(--ease-out);
    transform-style: preserve-3d;
    margin-bottom: 24px;
  }
  .cat {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .swatch {
    width: 18px;
    height: 2px;
    background: var(--accent);
  }
  .title {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.9rem, 3.2vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .tagline {
    margin-top: 14px;
    font-size: 1.05rem;
    color: color-mix(in srgb, var(--color-frost) 90%, var(--color-mist));
  }
  .for {
    flex: 1;
  }
  .for {
    margin-top: 12px;
    font-size: 0.86rem;
    color: var(--color-mist);
  }
  .for .label {
    color: var(--accent);
    margin-right: 4px;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--color-line);
  }
  .value {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--color-frost);
  }
  .metrics dd {
    font-size: 0.76rem;
    line-height: 1.35;
    margin-top: 4px;
  }
  .more {
    display: inline-flex;
    gap: 8px;
    margin-top: 22px;
    font-weight: 600;
    color: var(--accent);
  }
  .more span {
    transition: transform 0.35s var(--ease-out);
  }
  .card:hover .more span {
    transform: translateX(5px);
  }
  .soon {
    padding: 40px;
    text-align: center;
    justify-content: center;
  }
  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
