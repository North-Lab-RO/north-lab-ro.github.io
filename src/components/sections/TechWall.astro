---
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const st = t(lang).stack;
// Three orbits around the customer's own machine: the models, what runs and stores them, and the apps built on top.
const rings = [
  { tone: 'aurora', r: 17, dur: 46, items: ['Qwen', 'Mistral', 'BGE-M3', 'Whisper', 'Kokoro', 'SDXL'] },
  { tone: 'ice', r: 30, dur: 70, items: ['Ollama', 'ComfyUI', 'PaddleOCR', 'Qdrant', 'PostgreSQL', 'Redis', 'Celery', 'BullMQ'] },
  {
    tone: 'violet',
    r: 42,
    dur: 96,
    items: ['Python', 'FastAPI', 'TypeScript', 'React', 'Next.js', 'Fastify', 'Prisma', 'Docker', 'three.js', 'Lua', 'Vitest'],
  },
];
---

<section id="stack" class="section tech" aria-labelledby="stack-title">
  <div class="wrap layout">
    <header class="head">
      <p class="label" data-reveal>{st.label}</p>
      <h2 id="stack-title" class="h-section" data-reveal style="--delay:.06s">{st.title}</h2>
      <p class="lede" data-reveal style="--delay:.1s">{st.lede}</p>
      <ul class="legend" data-reveal style="--delay:.14s">
        {
          rings.map((ring, i) => (
            <li style={`--tone:var(--color-${ring.tone})`}>
              <span class="dot" aria-hidden="true" />
              {st.rings[i]}
              <span class="sr-only">: {ring.items.join(', ')}</span>
            </li>
          ))
        }
      </ul>
    </header>

    <div class="orbit" aria-hidden="true">
      <div class="core">
        <span class="pulse"></span>
        <span class="pulse late"></span>
        <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="7" rx="1.5" /><rect x="4" y="13" width="16" height="7" rx="1.5" /><path d="M8 7.5h.01M8 16.5h.01M12 7.5h4M12 16.5h4" /></svg>
        <span class="core-label">{st.core}</span>
      </div>
      {
        rings.map((ring, i) => (
          <div
            class:list={['orb-ring', i % 2 === 1 && 'ccw']}
            style={`--r:${ring.r}cqw;--dur:${ring.dur}s;--tone:var(--color-${ring.tone})`}
          >
            {ring.items.map((item, k) => (
              <span class="slot" style={`--a:${(360 / ring.items.length) * k + i * 17}deg`}>
                <span class="tag">{item}</span>
              </span>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* the turning rings' corners must never widen the page on a phone */
  .tech {
    overflow-x: clip;
  }
  .layout {
    display: grid;
    gap: 48px;
    align-items: center;
  }
  .head .label {
    margin-bottom: 20px;
  }
  .head .lede {
    margin-top: 24px;
    max-width: 40ch;
  }
  .legend {
    display: grid;
    gap: 10px;
    margin-top: 28px;
    font-size: 0.9rem;
    color: var(--color-mist);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .legend .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--tone);
    box-shadow: 0 0 10px color-mix(in srgb, var(--tone) 60%, transparent);
  }

  /* ── the orbit: pure CSS, so it keeps turning whatever the page's scripts are doing ── */
  .orbit {
    position: relative;
    container-type: inline-size;
    width: 100%;
    max-width: 600px;
    aspect-ratio: 1;
    justify-self: center;
  }
  .orb-ring {
    position: absolute;
    inset: 0;
    animation: spin var(--dur) linear infinite;
  }
  .orb-ring::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--r) * 2);
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px dashed color-mix(in srgb, var(--tone) 32%, transparent);
  }
  .slot {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: rotate(var(--a)) translateX(var(--r)) rotate(calc(-1 * var(--a)));
  }
  .tag {
    display: block;
    translate: -50% -50%;
    padding: 0.35em 0.75em;
    border: 1px solid color-mix(in srgb, var(--tone) 45%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-deep) 88%, transparent);
    font-family: var(--font-mono);
    font-size: clamp(0.6rem, 2.1cqw, 0.84rem);
    color: var(--color-frost);
    white-space: nowrap;
    /* turns back as fast as its ring turns, so every name stays upright */
    animation: spin var(--dur) linear infinite reverse;
  }
  .ccw {
    animation-direction: reverse;
  }
  .ccw .tag {
    animation-direction: normal;
  }
  /* a mouse can hold the orbit still to read it; on touch screens :hover sticks, so never there */
  @media (hover: hover) and (pointer: fine) {
    .orbit:hover .orb-ring,
    .orbit:hover .tag {
      animation-play-state: paused;
    }
  }
  .core {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 21cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--color-ice) 55%, transparent);
    background: radial-gradient(circle, color-mix(in srgb, var(--color-ice) 22%, var(--color-deep)), var(--color-deep) 70%);
    box-shadow: 0 0 40px -6px color-mix(in srgb, var(--color-ice) 55%, transparent);
  }
  .core svg {
    width: 34%;
    fill: none;
    stroke: var(--color-ice);
    stroke-width: 1.4;
    stroke-linecap: round;
    translate: 0 -12%;
  }
  .core-label {
    position: absolute;
    top: 62%;
    font-family: var(--font-mono);
    font-size: clamp(0.45rem, 1.5cqw, 0.66rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ice);
    white-space: nowrap;
  }
  .pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid var(--color-ice);
    animation: ping 4s var(--ease-out) infinite;
  }
  .pulse.late {
    animation-delay: 2s;
  }
  @keyframes spin {
    to {
      rotate: 360deg;
    }
  }
  @keyframes ping {
    from {
      opacity: 0.7;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 2.6;
    }
  }
  /* Reduced motion: the same orbit, turning much more slowly. */
  @media (prefers-reduced-motion: reduce) {
    .orb-ring,
    .tag {
      animation-duration: calc(var(--dur) * 2.5);
    }
    .pulse {
      animation-duration: 8s;
    }
  }
  @media (min-width: 900px) {
    .layout {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
