---
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const p = t(lang).process;
---

<section id="process" class="section process" aria-labelledby="process-title">
  <div class="wrap">
    <header class="head">
      <p class="label" data-reveal>{p.label}</p>
      <h2 id="process-title" class="h-section" data-reveal style="--delay:.06s">{p.title}</h2>
    </header>
    <ol class="steps">
      {
        p.steps.map((s, i) => (
          <li class="step" data-reveal style={`--delay:${i * 0.08}s`}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="h-sub">{s.title}</h3>
            <p class="muted">{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .head {
    max-width: 820px;
    margin-bottom: 48px;
  }
  .head .label {
    margin-bottom: 20px;
  }
  .steps {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
  }
  .step {
    position: relative;
    padding-top: 26px;
    border-top: 1px solid var(--color-line);
  }
  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 48px;
    height: 2px;
    background: var(--color-ice);
  }
  .num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-ice);
  }
  .step h3 {
    margin-top: 12px;
  }
  .step p {
    margin-top: 10px;
  }
  @media (min-width: 760px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .steps {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
