---
import Scene from '../3d/Scene.astro';
import { t, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const h = t(lang).hero;
---

<section class="hero" aria-labelledby="hero-title">
  <Scene name="northstar" class="hero-scene" label={h.scene} />
  <div class="veil" aria-hidden="true"></div>

  <div class="wrap content">
    <p class="label eyebrow" data-rise>
      <span class="local-dot" aria-hidden="true"></span>
      {h.eyebrow}
    </p>
    <h1 id="hero-title" class="display title" data-rise style="--delay:.08s">
      {h.title[0]}<br />{h.title[1]}<br /><em>{h.title[2]}</em>
    </h1>
    <p class="lede" data-rise style="--delay:.16s">{h.lede}</p>
    <div class="actions" data-rise style="--delay:.24s">
      <a href="#services" class="btn btn-primary">{h.ctaServices} <span aria-hidden="true">↓</span></a>
      <a href="#projects" class="btn btn-ghost">{h.ctaProjects}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: 72px;
    padding-bottom: clamp(40px, 7vw, 88px);
    isolation: isolate;
  }
  .hero :global(.hero-scene) {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .veil {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: linear-gradient(180deg, transparent 35%, color-mix(in srgb, var(--color-night) 88%, transparent) 78%, var(--color-night));
  }
  .content {
    position: relative;
    padding-top: 42svh;
  }
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 22px;
  }
  .title {
    font-size: clamp(2.4rem, 8vw, 6.2rem);
    max-width: 13ch;
  }
  .title em {
    font-style: normal;
    font-weight: 200;
    background: linear-gradient(100deg, var(--color-frost) 10%, var(--color-ice) 60%, var(--color-violet));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .lede {
    margin-top: 28px;
    max-width: 48ch;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }
  @media (min-width: 900px) {
    .content {
      padding-top: 0;
    }
    .hero {
      justify-content: center;
    }
  }
</style>
