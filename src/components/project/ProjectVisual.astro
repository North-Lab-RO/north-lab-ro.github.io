---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ATHENA_PROFILE, SHIELD_RINGS, meanderPath } from '../3d/athena-emblem';

interface Props {
  scene: 'none' | 'globe' | 'board' | 'radar' | 'ledger' | 'graph';
  cover?: ImageMetadata;
  coverAlt?: string;
  logo?: ImageMetadata;
  gallery?: { src: ImageMetadata; alt: string }[];
}
const { scene, cover, coverAlt = '', logo, gallery = [] } = Astro.props;

// Deterministic "globe" dots for the SVG card art.
const dots: { x: number; y: number; o: number }[] = [];
for (let i = 0; i < 420; i++) {
  const y = 1 - (i / 419) * 2;
  const r = Math.sqrt(1 - y * y);
  const th = Math.PI * (3 - Math.sqrt(5)) * i;
  const z = Math.sin(th) * r;
  if (z < -0.1) continue;
  dots.push({ x: 200 + Math.cos(th) * r * 130, y: 150 + y * 130, o: 0.15 + z * 0.7 });
}
const story = { x: 236, y: 104 };
const sources = [
  [98, 180], [130, 62], [300, 190], [210, 250], [320, 96], [150, 230], [262, 38],
];
const polaroids = gallery.slice(0, 3);
// Ledger rows for the Banky art: widths of the description and amount bars, and whether the guard passed them.
// Network art for ATHENA: subject in the middle, identifiers around it, findings on the outside.
const netNodes = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 2;
  return { x: 200 + Math.cos(a) * 92, y: 150 + Math.sin(a) * 76, a };
});
const netFinds = netNodes.flatMap((n, i) =>
  [-0.32, 0.32].map((d, k) => ({
    x: 200 + Math.cos(n.a + d) * 138,
    y: 150 + Math.sin(n.a + d) * 112,
    from: n,
    state: (i + k) % 4 === 1 ? 'rej' : (i + k) % 3 === 0 ? 'pend' : 'ok',
  })),
);
const ledgerRows = [
  [0.46, 0.18, true],
  [0.3, 0.14, true],
  [0.52, 0.2, false],
  [0.38, 0.16, true],
  [0.44, 0.22, true],
  [0.28, 0.12, true],
] as const;
---

<div class:list={['visual', `v-${scene}`]}>
  {
    scene === 'globe' && (
      <svg viewBox="0 0 400 300" class="art" aria-hidden="true">
        {dots.map((d) => (
          <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="1.4" fill="var(--color-ice)" opacity={d.o.toFixed(2)} />
        ))}
        {sources.map(([x, y], i) => (
          <>
            <path
              class="arc"
              style={`--i:${i}`}
              d={`M${x},${y} Q${(x + story.x) / 2},${Math.min(y, story.y) - 60} ${story.x},${story.y}`}
            />
            <circle cx={x} cy={y} r="3" fill="var(--color-frost)" />
          </>
        ))}
        <circle cx={story.x} cy={story.y} r="6" fill="var(--color-aurora)" class="story" />
      </svg>
    )
  }
  {
    scene === 'radar' && (
      <div class="radar" aria-hidden="true">
        <div class="sweep" />
        <svg viewBox="0 0 300 300" class="scope">
          {[40, 80, 120, 146].map((r) => (
            <circle cx="150" cy="150" r={r} fill="none" stroke="var(--color-aurora)" stroke-opacity={r === 146 ? 0.5 : 0.18} />
          ))}
          <path d="M4 150H296M150 4V296" stroke="var(--color-aurora)" stroke-opacity=".15" />
          <rect x="128" y="147" width="44" height="5" fill="var(--color-frost)" transform="rotate(-8 150 150)" />
          {[[70, 96], [220, 70], [238, 208], [96, 222], [182, 118]].map(([x, y], i) => (
            <circle cx={x} cy={y} r="3.5" fill="var(--color-aurora)" class="blip" style={`--i:${i}`} />
          ))}
        </svg>
      </div>
    )
  }
  {
    scene === 'board' && polaroids.length > 0 && (
      <div class="board" aria-hidden="true">
        {polaroids.map((p, i) => (
          <figure class="polaroid" style={`--i:${i}`}>
            <Image src={p.src} alt="" widths={[360, 540]} sizes="(min-width: 960px) 20vw, 40vw" />
          </figure>
        ))}
      </div>
    )
  }
  {
    scene === 'graph' && (
      <svg viewBox="0 0 400 300" class="art graph" aria-hidden="true">
        <g class="shield" transform="translate(200 150) scale(1.45) translate(-100 -100)" fill="none" stroke-linecap="round" stroke-linejoin="round">
          {SHIELD_RINGS.map(([r, w]) => (
            <circle cx="100" cy="100" r={r} stroke="#818cf8" stroke-width={w * 0.9} stroke-opacity=".45" />
          ))}
          <path d={meanderPath(100, 100, 78, 92, 24)} stroke="#818cf8" stroke-width=".7" stroke-opacity=".4" />
          <g transform="translate(100 100) scale(0.66) translate(-97 -106)" stroke="#c7d2fe" stroke-width="1.5" stroke-opacity=".38">
            {ATHENA_PROFILE.map((d) => <path d={d} />)}
          </g>
        </g>
        {netNodes.map((n) => (
          <line x1="200" y1="150" x2={n.x.toFixed(1)} y2={n.y.toFixed(1)} stroke="#818cf8" stroke-opacity=".5" />
        ))}
        {netFinds.map((f) => (
          <line x1={f.from.x.toFixed(1)} y1={f.from.y.toFixed(1)} x2={f.x.toFixed(1)} y2={f.y.toFixed(1)} stroke="#818cf8" stroke-opacity=".22" />
        ))}
        {netFinds.map((f, i) => (
          <circle cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r="5" class:list={['find', f.state]} style={`--i:${i}`} />
        ))}
        {netNodes.map((n) => (
          <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r="7" fill="#c7d2fe" />
        ))}
        <circle cx="200" cy="150" r="30" fill="#818cf8" fill-opacity=".15" class="halo" />
        <circle cx="200" cy="150" r="14" fill="#818cf8" />
      </svg>
    )
  }
  {
    scene === 'ledger' && (
      <svg viewBox="0 0 400 300" class="art ledger" aria-hidden="true">
        <rect x="92" y="26" width="216" height="252" rx="6" fill="var(--color-panel)" stroke="var(--color-line)" />
        <rect x="112" y="44" width="80" height="8" rx="2" fill="var(--color-mist)" opacity=".5" />
        <rect x="244" y="44" width="44" height="8" rx="2" fill="var(--color-violet)" opacity=".7" />
        {ledgerRows.map(([d, a, ok], i) => (
          <g class="row" style={`--i:${i}`}>
            <rect x="112" y={80 + i * 30} width={d * 216} height="6" rx="2" fill="var(--color-frost)" opacity=".35" />
            <rect x={288 - a * 216} y={80 + i * 30} width={a * 216} height="6" rx="2" fill={ok ? 'var(--color-frost)' : 'var(--color-ember)'} opacity=".75" />
            {ok ? (
              <path class="mark" d={`M322 ${83 + i * 30}l5 5 9-10`} fill="none" stroke="var(--color-aurora)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            ) : (
              <path class="mark" d={`M323 ${77 + i * 30}l10 10m0-10l-10 10`} fill="none" stroke="var(--color-ember)" stroke-width="2.4" stroke-linecap="round" />
            )}
          </g>
        ))}
        <rect class="beam" x="86" y="60" width="228" height="3" rx="1.5" fill="var(--color-violet)" />
      </svg>
    )
  }
  {scene === 'none' && cover && <Image src={cover} alt={coverAlt} widths={[640, 960]} sizes="(min-width: 960px) 50vw, 100vw" class="cover" />}
  {logo && scene === 'globe' && <Image src={logo} alt="" class="logo" width={180} />}
</div>

<style>
  .visual {
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background:
      radial-gradient(70% 70% at 50% 45%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%),
      var(--color-deep);
  }
  .art,
  .cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .arc {
    fill: none;
    stroke: var(--color-ice);
    stroke-width: 1.2;
    stroke-dasharray: 6 260;
    stroke-dashoffset: 266;
    opacity: 0.9;
    animation: flow 3.2s linear infinite;
    animation-delay: calc(var(--i) * -0.45s);
  }
  .story {
    filter: drop-shadow(0 0 8px var(--color-aurora));
    animation: pulse 2.2s ease-in-out infinite;
  }
  @keyframes flow {
    to {
      stroke-dashoffset: 0;
    }
  }
  .logo {
    position: absolute;
    right: 18px;
    bottom: 16px;
    width: 76px;
    height: auto;
    opacity: 0.9;
  }
  .radar {
    position: absolute;
    inset: 8%;
    display: grid;
    place-items: center;
  }
  .scope {
    position: relative;
    height: 100%;
    width: auto;
  }
  .sweep {
    position: absolute;
    aspect-ratio: 1;
    height: 97%;
    border-radius: 50%;
    background: conic-gradient(from 0deg, color-mix(in srgb, var(--color-aurora) 55%, transparent), transparent 22%, transparent);
    animation: spin 4s linear infinite;
  }
  .blip {
    animation: blip 4s linear infinite;
    animation-delay: calc(var(--i) * -0.8s);
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  @keyframes blip {
    0%,
    100% {
      opacity: 0.25;
    }
    8% {
      opacity: 1;
    }
  }
  .graph .find {
    fill: #eab308;
    animation: review 6s ease-in-out infinite;
    animation-delay: calc(var(--i) * -0.37s);
  }
  .graph .find.ok {
    --end: #22c55e;
  }
  .graph .find.rej {
    --end: #ef4444;
  }
  .graph .find.pend {
    --end: #eab308;
  }
  @keyframes review {
    0%,
    40% {
      fill: #eab308;
      opacity: 1;
    }
    55%,
    100% {
      fill: var(--end);
      opacity: 0.95;
    }
  }
  .graph .halo {
    animation: pulse 2.6s ease-in-out infinite;
  }
  .ledger .beam {
    filter: drop-shadow(0 0 8px var(--color-violet));
    animation: scan 4.8s var(--ease-out) infinite;
  }
  .ledger .mark {
    stroke-dasharray: 24;
    stroke-dashoffset: 24;
    animation: tick 4.8s linear infinite;
    animation-delay: calc(var(--i) * 0.45s + 0.3s);
  }
  @keyframes scan {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    8% {
      opacity: 1;
    }
    70% {
      transform: translateY(190px);
      opacity: 1;
    }
    85%,
    100% {
      transform: translateY(190px);
      opacity: 0;
    }
  }
  @keyframes tick {
    0%,
    6% {
      stroke-dashoffset: 24;
    }
    14%,
    88% {
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dashoffset: 24;
    }
  }
  .board {
    position: absolute;
    inset: 0;
    perspective: 900px;
  }
  .polaroid {
    position: absolute;
    width: 40%;
    padding: 6px 6px 22px;
    background: #e9e4d8;
    box-shadow: 0 18px 40px rgb(0 0 0 / 0.5);
    transition: transform 0.7s var(--ease-out);
  }
  .polaroid img {
    aspect-ratio: 1;
    object-fit: cover;
    width: 100%;
  }
  .polaroid:nth-child(1) {
    left: 8%;
    top: 12%;
    transform: rotate(-7deg);
  }
  .polaroid:nth-child(2) {
    left: 32%;
    top: 22%;
    transform: rotate(4deg);
    z-index: 2;
  }
  .polaroid:nth-child(3) {
    left: 54%;
    top: 9%;
    transform: rotate(-3deg);
  }
  .polaroid::after {
    content: '';
    position: absolute;
    top: -5px;
    left: calc(50% - 5px);
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-ember);
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.5);
  }
  :global(.card:hover) .polaroid:nth-child(1) {
    transform: rotate(-11deg) translate(-6%, -3%);
  }
  :global(.card:hover) .polaroid:nth-child(3) {
    transform: rotate(2deg) translate(6%, -3%);
  }
  :global(.card:hover) .polaroid:nth-child(2) {
    transform: rotate(1deg) translateY(-4%) scale(1.04);
  }
</style>
