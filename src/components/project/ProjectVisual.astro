---
/**
 * Card art for each product: a ~7 s looping miniature of what the product does, in SVG and CSS only.
 * Timing: every animated part runs on the same loop (--T) and starts at its own point in it (--at, a fraction).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ATHENA_PROFILE, SHIELD_RINGS, meanderPath } from '../3d/athena-emblem';
import type { Lang } from '../../i18n/ui';

interface Props {
  scene: 'none' | 'globe' | 'board' | 'radar' | 'ledger' | 'graph';
  cover?: ImageMetadata;
  coverAlt?: string;
  logo?: ImageMetadata;
  gallery?: { src: ImageMetadata; alt: string }[];
  lang?: Lang;
}
const { scene, cover, coverAlt = '', logo, gallery = [], lang = 'en' } = Astro.props;

const TXT = {
  en: {
    politics: 'Politics',
    health: 'Health',
    rising: '▲ Rising',
    alert: '⚠ Alert · 72',
    briefing: 'Briefing 07:00',
    vpn: 'VPN',
    report: 'Report',
    ledger: 'Ledger',
    cats: ['Groceries', 'Housing', 'Pharmacy', 'Salary', 'Transport'],
    fill: '⚠ you fill it in',
    budget: 'Groceries budget · 78%',
    frame: '50 / 30 / 20',
    local: 'Local · offline',
    heard: 'heard ✓',
    day: 'Day 3 / 10',
    lab: 'DNA',
    verdict: 'CONVICTED',
  },
  ro: {
    politics: 'Politică',
    health: 'Sănătate',
    rising: '▲ În creștere',
    alert: '⚠ Alertă · 72',
    briefing: 'Sinteză 07:00',
    vpn: 'VPN',
    report: 'Raport',
    ledger: 'Registru',
    cats: ['Alimente', 'Locuință', 'Farmacie', 'Salariu', 'Transport'],
    fill: '⚠ completezi tu',
    budget: 'Buget alimente · 78%',
    frame: '50 / 30 / 20',
    local: 'Local · offline',
    heard: 'auzit ✓',
    day: 'Ziua 3 / 10',
    lab: 'ADN',
    verdict: 'CONDAMNAT',
  },
}[lang];
// Width of a text chip in user units, for mono text of the given size.
const chipW = (s: string, size = 10) => Math.round([...s].length * size * 0.62 + 14);

// Deterministic "globe" dots for the SVG card art.
const dots: { x: number; y: number; o: number }[] = [];
for (let i = 0; i < 420; i++) {
  const y = 1 - (i / 419) * 2;
  const r = Math.sqrt(1 - y * y);
  const th = Math.PI * (3 - Math.sqrt(5)) * i;
  const z = Math.sin(th) * r;
  if (z < -0.1) continue;
  dots.push({ x: 200 + Math.cos(th) * r * 130, y: 150 + y * 130, o: 0.15 + z * 0.7 });
}
// COUNSELOR: the lead story (politics) and other stories in their real category colours.
const story = { x: 236, y: 104 };
const otherStories = [
  { x: 150, y: 118, c: '#4dffb8' }, // health
  { x: 292, y: 168, c: '#fbbf24' }, // economy
  { x: 178, y: 206, c: '#ff5a6a' }, // military
  { x: 118, y: 186, c: '#fb923c' }, // energy
];
const sources = [
  [98, 180], [130, 62], [300, 190], [210, 250], [320, 96], [150, 230], [262, 38],
];
const polaroids = gallery.slice(0, 3);

// ATHENA: subject in the middle, identifiers around it, findings on the outside.
const netNodes = Array.from({ length: 8 }, (_, i) => {
  const a = (i / 8) * Math.PI * 2 - Math.PI / 2;
  return { x: 200 + Math.cos(a) * 92, y: 150 + Math.sin(a) * 76, a };
});
const netFinds = netNodes.flatMap((n, i) =>
  [-0.32, 0.32].map((d, k) => ({
    x: 200 + Math.cos(n.a + d) * 138,
    y: 150 + Math.sin(n.a + d) * 112,
    from: n,
    state: (i + k) % 4 === 1 ? 'rej' : (i + k) % 3 === 0 ? 'pend' : 'ok',
  })),
);
// collectors in the corners send their searches to the nearest identifier
const collectors = [
  { label: 'Web', x: 40, y: 26 },
  { label: 'DNS', x: 360, y: 26 },
  { label: 'Social', x: 40, y: 276 },
  { label: 'Image', x: 360, y: 276 },
].map((c) => {
  const n = netNodes.reduce((a, b) => (Math.hypot(b.x - c.x, b.y - c.y) < Math.hypot(a.x - c.x, a.y - c.y) ? b : a));
  return { ...c, dx: Math.round(n.x - c.x), dy: Math.round(n.y - c.y) };
});

// BANKY: rows of a scanned statement: description width, amount width, and whether the guard passed them.
const ledgerRows = [
  [0.62, 0.3, true],
  [0.4, 0.22, true],
  [0.7, 0.34, false],
  [0.5, 0.26, true],
  [0.58, 0.3, true],
  [0.36, 0.2, true],
] as const;
let okIndex = -1;
const ledgerPlan = ledgerRows.map(([, , ok], i) => ({ ok, slot: ok ? ++okIndex : -1, at: 0.06 + i * 0.07 }));

// AI_ATC: traffic coloured by wake category, as on the product's map.
const wake = { heavy: '#f87171', medium: '#60a5fa', light: '#4ade80', super: '#e879f9' };
const blips: [number, number, string][] = [
  [70, 96, wake.heavy],
  [220, 70, wake.medium],
  [238, 208, wake.medium],
  [96, 222, wake.light],
  [196, 112, wake.super],
];
---

<div class:list={['visual', `v-${scene}`]}>
  {
    scene === 'globe' && (
      <svg viewBox="0 0 400 300" class="art" aria-hidden="true">
        {dots.map((d) => (
          <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="1.4" fill="var(--color-ice)" opacity={d.o.toFixed(2)} />
        ))}
        {sources.map(([x, y], i) => (
          <>
            <path
              class="arc"
              style={`--i:${i}`}
              d={`M${x},${y} Q${(x + story.x) / 2},${Math.min(y, story.y) - 60} ${story.x},${story.y}`}
            />
            <circle cx={x} cy={y} r="3" fill="var(--color-frost)" />
          </>
        ))}
        {otherStories.map((s) => (
          <circle cx={s.x} cy={s.y} r="4.5" fill={s.c} class="soft" />
        ))}
        {/* trends rising: the lead story's spike grows as sources join */}
        <line x1={story.x} y1={story.y} x2={story.x} y2={story.y - 48} stroke="#9a8cff" stroke-width="3" stroke-linecap="round" class="anim growY" style="--at:.04" />
        <circle cx={story.x} cy={story.y} r="6" fill="#9a8cff" class="story" />
        {/* alert: importance crosses the threshold */}
        <circle cx={story.x} cy={story.y} r="12" fill="none" stroke="#ff5a6a" stroke-width="2" class="anim ring" style="--at:.44" />
        <circle cx={story.x} cy={story.y} r="12" fill="none" stroke="#ff5a6a" stroke-width="2" class="anim ring" style="--at:.52" />
        <g class="t">
          <rect x={story.x + 12} y={story.y - 11} width={chipW(TXT.politics)} height="18" rx="9" class="chip" stroke="#9a8cff" />
          <text x={story.x + 12 + chipW(TXT.politics) / 2} y={story.y + 2} fill="#9a8cff">{TXT.politics}</text>
          <rect x={150 - chipW(TXT.health) / 2} y="92" width={chipW(TXT.health)} height="18" rx="9" class="chip" stroke="#4dffb8" />
          <text x="150" y="105" fill="#4dffb8">{TXT.health}</text>
          <g class="anim show40" style="--at:.14">
            <rect x={story.x - chipW(TXT.rising) / 2} y={story.y - 76} width={chipW(TXT.rising)} height="18" rx="9" class="chip" stroke="#4dffb8" />
            <text x={story.x} y={story.y - 63} fill="#4dffb8">{TXT.rising}</text>
          </g>
          <g class="anim show25" style="--at:.46">
            <rect x={story.x - chipW(TXT.alert) / 2} y={story.y + 16} width={chipW(TXT.alert)} height="18" rx="9" class="chip" stroke="#ff5a6a" />
            <text x={story.x} y={story.y + 29} fill="#ff5a6a">{TXT.alert}</text>
          </g>
        </g>
        {/* reporting: the briefing fills with the top stories */}
        <g class="anim show40" style="--at:.6">
          <rect x="10" y="206" width="90" height="72" rx="6" fill="#e8f3ff" />
          <text x="18" y="222" class="t doc-title">{TXT.briefing}</text>
          {['#9a8cff', '#4dffb8', '#fbbf24', '#ff5a6a'].map((c, i) => (
            <g class="anim grow40" style={`--at:${0.62 + i * 0.04}`}>
              <rect x="18" y={232 + i * 11} width="5" height="5" rx="1" fill={c} />
              <rect x="27" y={233 + i * 11} width={52 - (i % 2) * 12} height="3" rx="1.5" fill="#0a1426" opacity=".5" />
            </g>
          ))}
        </g>
      </svg>
    )
  }
  {
    scene === 'radar' && (
      <>
        <div class="radar" aria-hidden="true">
          <div class="sweep" />
          <svg viewBox="0 0 300 300" class="scope">
            {[40, 80, 120, 146].map((r) => (
              <circle cx="150" cy="150" r={r} fill="none" stroke="var(--color-aurora)" stroke-opacity={r === 146 ? 0.5 : 0.18} />
            ))}
            <path d="M4 150H296M150 4V296" stroke="var(--color-aurora)" stroke-opacity=".15" />
            <rect x="124" y="147" width="52" height="6" fill="var(--color-frost)" transform="rotate(-8 150 150)" />
            {/* the control tower beside the runway, with its beacon */}
            <g transform="translate(160 162)">
              <rect x="-2" y="0" width="4" height="16" fill="#0a1426" stroke="var(--color-aurora)" stroke-width="1.2" />
              <rect x="-7" y="-6" width="14" height="6" rx="1" fill="var(--color-aurora)" fill-opacity=".35" stroke="var(--color-aurora)" stroke-width="1.2" />
              <circle cx="0" cy="-9" r="2.2" fill="#ff5a6a" class="beacon" />
            </g>
            {blips.map(([x, y, c], i) => (
              <circle cx={x} cy={y} r="4" fill={c} class="blip" style={`--i:${i}`} />
            ))}
          </svg>
        </div>
        {/* one radio exchange, as the product handles it: heard, understood, checked, answered */}
        <svg viewBox="0 0 400 84" class="radio t" aria-hidden="true">
          <g class="anim show60" style="--at:.02">
            <rect x="8" y="8" width="172" height="24" rx="12" class="bubble" />
            <text x="94" y="24">NLB204, request taxi</text>
          </g>
          <g class="anim show60" style="--at:.1">
            <rect x="188" y="10" width={chipW(TXT.heard)} height="20" rx="10" class="chip" stroke="#8be9ff" />
            <text x={188 + chipW(TXT.heard) / 2} y="24" fill="#8be9ff">{TXT.heard}</text>
          </g>
          <g class="anim show60" style="--at:.17">
            <rect x="262" y="10" width="46" height="20" rx="10" class="chip" stroke="#fbbf24" />
            <text x="285" y="24" fill="#fbbf24">TAXI</text>
          </g>
          <g class="anim show60" style="--at:.24">
            <rect x="316" y="10" width="72" height="20" rx="10" class="chip" stroke="#4dffb8" />
            <text x="352" y="24" fill="#4dffb8">✓ ✓ ✓</text>
          </g>
          <g class="anim show60" style="--at:.32">
            <rect x="8" y="46" width="300" height="26" rx="13" class="bubble atc" />
            <text x="158" y="63">NLB204, taxi via B, hold short 08R</text>
          </g>
          <g class="anim show60" style="--at:.34">
            {Array.from({ length: 9 }, (_, i) => (
              <rect x={318 + i * 8} y="50" width="4" height="18" rx="2" fill="#4dffb8" class="bar" style={`--i:${i}`} />
            ))}
          </g>
        </svg>
      </>
    )
  }
  {
    scene === 'board' && polaroids.length > 0 && (
      <div class="board" aria-hidden="true">
        {polaroids.map((p, i) => (
          <figure class="polaroid" style={`--i:${i}`}>
            <Image src={p.src} alt="" widths={[360, 540]} sizes="(min-width: 960px) 20vw, 40vw" />
          </figure>
        ))}
        {/* the investigation: a red string between the clues, the clock, the lab, then the verdict */}
        <svg viewBox="0 0 400 300" class="overlay t">
          <path d="M112 36 Q160 74 208 66 Q252 46 296 27" class="anim string" style="--at:.04" />
          <g transform="translate(14 256)">
            <rect width={chipW(TXT.day) + 28} height="26" rx="13" class="chip dark" stroke="#e9e4d8" />
            <circle cx="15" cy="13" r="7" fill="none" stroke="#e9e4d8" stroke-width="1.4" />
            <line x1="15" y1="13" x2="15" y2="8" stroke="#e9e4d8" stroke-width="1.4" stroke-linecap="round" class="hand" />
            <text x={28 + chipW(TXT.day) / 2} y="17" fill="#e9e4d8">{TXT.day}</text>
          </g>
          <g transform="translate(168 256)">
            <rect width="118" height="26" rx="13" class="chip dark" stroke="#8be9ff" />
            <text x="22" y="17" fill="#8be9ff">{TXT.lab}</text>
            <rect x="44" y="10" width="62" height="6" rx="3" fill="#8be9ff" opacity=".2" />
            <rect x="44" y="10" width="62" height="6" rx="3" fill="#8be9ff" class="anim grow40" style="--at:.24" />
          </g>
          <g class="anim stamp" style="--at:.7">
            <g transform="translate(262 196) rotate(-12)">
              <rect x={-chipW(TXT.verdict, 18) / 2} y="-18" width={chipW(TXT.verdict, 18)} height="36" rx="4" fill="rgba(10,6,8,0.55)" stroke="#ff5a6a" stroke-width="3" />
              <text x="0" y="7" class="verdict">{TXT.verdict}</text>
            </g>
          </g>
        </svg>
      </div>
    )
  }
  {
    scene === 'graph' && (
      <svg viewBox="0 0 400 300" class="art graph" aria-hidden="true">
        <g class="shield" transform="translate(200 150) scale(1.45) translate(-100 -100)" fill="none" stroke-linecap="round" stroke-linejoin="round">
          {SHIELD_RINGS.map(([r, w]) => (
            <circle cx="100" cy="100" r={r} stroke="#818cf8" stroke-width={w * 0.9} stroke-opacity=".45" />
          ))}
          <path d={meanderPath(100, 100, 78, 92, 24)} stroke="#818cf8" stroke-width=".7" stroke-opacity=".4" />
          <g transform="translate(100 100) scale(0.66) translate(-97 -106)" stroke="#c7d2fe" stroke-width="1.5" stroke-opacity=".38">
            {ATHENA_PROFILE.map((d) => <path d={d} />)}
          </g>
        </g>
        {netNodes.map((n) => (
          <line x1="200" y1="150" x2={n.x.toFixed(1)} y2={n.y.toFixed(1)} stroke="#818cf8" stroke-opacity=".5" />
        ))}
        {netFinds.map((f) => (
          <line x1={f.from.x.toFixed(1)} y1={f.from.y.toFixed(1)} x2={f.x.toFixed(1)} y2={f.y.toFixed(1)} stroke="#818cf8" stroke-opacity=".22" />
        ))}
        {netFinds.map((f, i) => (
          <circle cx={f.x.toFixed(1)} cy={f.y.toFixed(1)} r="5" class:list={['find', f.state]} style={`--i:${i}`} />
        ))}
        {netNodes.map((n) => (
          <circle cx={n.x.toFixed(1)} cy={n.y.toFixed(1)} r="7" fill="#c7d2fe" />
        ))}
        <circle cx="200" cy="150" r="30" fill="#818cf8" fill-opacity=".15" class="halo" />
        <circle cx="200" cy="150" r="14" fill="#818cf8" />
        {/* collect: each collector sends its search to an identifier */}
        <g class="t">
          {collectors.map((c, k) => (
            <>
              <circle cx={c.x} cy={c.y} r="3.5" fill="#fbbf24" class="anim travel" style={`--at:${0.02 + k * 0.04};--dx:${c.dx}px;--dy:${c.dy}px`} />
              <circle cx={c.x} cy={c.y} r="3.5" fill="#fbbf24" class="anim travel" style={`--at:${0.2 + k * 0.04};--dx:${c.dx}px;--dy:${c.dy}px`} />
              <rect x={c.x - chipW(c.label) / 2} y={c.y - 9} width={chipW(c.label)} height="18" rx="9" class="chip" stroke="#a5b4fc" />
              <text x={c.x} y={c.y + 4} fill="#c7d2fe">{c.label}</text>
            </>
          ))}
          <g transform="translate(200 20)">
            <rect x="-26" y="-9" width="52" height="18" rx="9" class="chip" stroke="#4dffb8" />
            <circle cx="-14" cy="0" r="3" fill="#4dffb8" class="beacon" />
            <text x="6" y="4" fill="#4dffb8">{TXT.vpn}</text>
          </g>
          {/* report: confirmed findings go into the PDF; rejected ones never do */}
          {[0, 1, 2].map((k) => (
            <circle cx="200" cy="150" r="3.5" fill="#22c55e" class="anim travel" style={`--at:${0.6 + k * 0.05};--dx:162px;--dy:${-4 + k * 4}px`} />
          ))}
          <g transform="translate(346 124)">
            <rect width="40" height="52" rx="4" fill="#e8f3ff" />
            <text x="20" y="13" class="doc-title" text-anchor="middle">PDF</text>
            {[0, 1, 2, 3].map((i) => (
              <rect x="7" y={20 + i * 7} width={26 - (i % 2) * 8} height="3" rx="1.5" fill="#0a1426" opacity=".5" class="anim grow40" style={`--at:${0.66 + i * 0.04}`} />
            ))}
          </g>
          <text x="366" y="190" fill="#c7d2fe" class="small">{TXT.report}</text>
        </g>
      </svg>
    )
  }
  {
    scene === 'ledger' && (
      <svg viewBox="0 0 400 300" class="art ledger t" aria-hidden="true">
        {/* the scanned statement */}
        <rect x="20" y="22" width="200" height="206" rx="6" fill="var(--color-panel)" stroke="var(--color-line)" />
        <rect x="36" y="36" width="70" height="7" rx="2" fill="var(--color-mist)" opacity=".5" />
        <rect x="170" y="36" width="36" height="7" rx="2" fill="var(--color-violet)" opacity=".7" />
        {ledgerRows.map(([d, a, ok], i) => (
          <g>
            <rect x="36" y={62 + i * 26} width={d * 120} height="6" rx="2" fill="var(--color-frost)" opacity=".35" />
            <rect x={206 - a * 120} y={62 + i * 26} width={a * 120} height="6" rx="2" fill={ok ? 'var(--color-frost)' : 'var(--color-ember)'} opacity=".75" />
            {ok ? (
              <path class="anim tick" style={`--at:${ledgerPlan[i].at}`} d={`M226 ${64 + i * 26}l4 4 8-9`} fill="none" stroke="var(--color-aurora)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
            ) : (
              <>
                <line x1={200 - a * 120} y1={65 + i * 26} x2="212" y2={65 + i * 26} stroke="var(--color-ember)" stroke-width="1.6" class="anim grow40" style={`--at:${ledgerPlan[i].at}`} />
                <path class="anim tick" style={`--at:${ledgerPlan[i].at}`} d={`M226 ${60 + i * 26}l9 9m0-9l-9 9`} fill="none" stroke="var(--color-ember)" stroke-width="2.4" stroke-linecap="round" />
              </>
            )}
          </g>
        ))}
        <rect class="beam" x="16" y="50" width="208" height="3" rx="1.5" fill="var(--color-violet)" />
        {/* the ledger: confirmed rows arrive with their category; the doubtful one waits for you */}
        <text x="262" y="40" class="head" fill="var(--color-mist)">{TXT.ledger}</text>
        {ledgerPlan.map((r) =>
          r.ok ? (
            <g class="anim slide" style={`--at:${r.at + 0.05}`}>
              <rect x="262" y={50 + r.slot * 30} width="120" height="24" rx="5" fill="var(--color-panel)" stroke="var(--color-line)" />
              <rect x="270" y={59 + r.slot * 30} width="28" height="5" rx="2" fill="var(--color-frost)" opacity=".7" />
              <rect x="304" y={55 + r.slot * 30} width={chipW(TXT.cats[r.slot], 8)} height="14" rx="7" fill="none" stroke="var(--color-violet)" />
              <text x={304 + chipW(TXT.cats[r.slot], 8) / 2} y={65 + r.slot * 30} class="small" fill="#c4bcff">{TXT.cats[r.slot]}</text>
            </g>
          ) : (
            <g class="anim show40" style={`--at:${r.at + 0.04}`}>
              {/* the doubtful row stays on the statement, waiting for you: it never reaches the ledger */}
              <rect x="36" y="206" width={chipW(TXT.fill, 8)} height="15" rx="7.5" class="chip" stroke="#fbbf24" />
              <text x={36 + chipW(TXT.fill, 8) / 2} y="217" class="small" fill="#fbbf24">{TXT.fill}</text>
            </g>
          ),
        )}
        <g transform="translate(262 14)">
          <rect width={chipW(TXT.local, 8)} height="15" rx="7.5" class="chip" stroke="#4dffb8" />
          <text x={chipW(TXT.local, 8) / 2} y="11" class="small" fill="#4dffb8">{TXT.local}</text>
        </g>
        {/* budgets: the category budget fills and turns amber past 75%; the 50/30/20 split fills */}
        <text x="20" y="250" class="small left" fill="var(--color-mist)">{TXT.budget}</text>
        <rect x="20" y="256" width="360" height="8" rx="4" fill="var(--color-line)" />
        <rect x="20" y="256" width="281" height="8" rx="4" fill="var(--color-aurora)" class="anim grow40" style="--at:.42" />
        <rect x="20" y="256" width="281" height="8" rx="4" fill="#fbbf24" class="anim show25" style="--at:.5" />
        <text x="20" y="280" class="small left" fill="var(--color-mist)">{TXT.frame}</text>
        <rect x="96" y="274" width="142" height="7" rx="3" fill="var(--color-violet)" class="anim grow40" style="--at:.56" />
        <rect x="240" y="274" width="85" height="7" rx="3" fill="var(--color-ice)" class="anim grow40" style="--at:.6" />
        <rect x="327" y="274" width="53" height="7" rx="3" fill="var(--color-aurora)" class="anim grow40" style="--at:.64" />
      </svg>
    )
  }
  {scene === 'none' && cover && <Image src={cover} alt={coverAlt} widths={[640, 960]} sizes="(min-width: 960px) 50vw, 100vw" class="cover" />}
  {logo && scene === 'globe' && <Image src={logo} alt="" class="logo" width={180} />}
</div>

<style>
  .visual {
    /* short loops: visitors glance for 5–10 s, so every beat shows up within one look */
    --T: 7s;
    position: relative;
    aspect-ratio: 4 / 3;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background:
